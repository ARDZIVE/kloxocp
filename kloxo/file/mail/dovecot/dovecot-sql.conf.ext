# Kloxo CP: Dovecot SQL (GENERATED by `kloxo-mail render`, do not edit). Read-only DB account.
driver = mysql
connect = host=@@DB_SOCKET@@ dbname=@@DB_NAME@@ user=@@DB_RO_USER@@ password=@@DB_RO_PASS@@
default_pass_scheme = ARGON2ID

password_query = SELECT m.email AS user, m.password_hash AS password FROM mailboxes m JOIN domains d ON d.id = m.domain_id WHERE m.email = '%Lu' AND m.active = 1 AND d.active = 1

user_query = SELECT '@@VMAIL_DIR@@/%Ld/%Ln' AS home, @@VMAIL_UID@@ AS uid, @@VMAIL_GID@@ AS gid, CONCAT('*:storage=', m.quota_mb, 'M') AS quota_rule FROM mailboxes m JOIN domains d ON d.id = m.domain_id WHERE m.email = '%Lu' AND m.active = 1 AND d.active = 1

iterate_query = SELECT m.email AS user FROM mailboxes m JOIN domains d ON d.id = m.domain_id WHERE m.active = 1 AND d.active = 1
