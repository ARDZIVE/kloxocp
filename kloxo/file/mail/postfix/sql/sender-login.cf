# Kloxo CP: Postfix SQL map (GENERATED by `kloxo-mail render`, do not edit). Read-only DB account.
hosts = unix:@@DB_SOCKET@@
user = @@DB_RO_USER@@
password = @@DB_RO_PASS@@
dbname = @@DB_NAME@@
query = SELECT m.email FROM mailboxes m JOIN domains d ON d.id = m.domain_id WHERE m.email = '%s' AND m.active = 1 AND d.active = 1 UNION SELECT m.email FROM aliases a JOIN alias_targets t ON t.alias_id = a.id JOIN mailboxes m ON m.email = t.target JOIN domains d ON d.id = a.domain_id WHERE a.source = '%s' AND a.active = 1 AND d.active = 1 AND m.active = 1
