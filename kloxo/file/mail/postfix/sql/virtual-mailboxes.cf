# Kloxo CP: Postfix SQL map (GENERATED by `kloxo-mail render`, do not edit). Read-only DB account.
hosts = unix:@@DB_SOCKET@@
user = @@DB_RO_USER@@
password = @@DB_RO_PASS@@
dbname = @@DB_NAME@@
query = SELECT 1 FROM mailboxes m JOIN domains d ON d.id = m.domain_id WHERE m.email = '%s' AND m.active = 1 AND d.active = 1
