# ---------------------------------------------------------------------------
# Kloxo CP: Postfix main.cf  (GENERATED by `kloxo-mail render`, do not edit)
# Put your own settings in /etc/kloxo/mail.d/postfix-main.cf; they are appended
# at the end of this file and survive updates.
# ---------------------------------------------------------------------------
compatibility_level = 3.8
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

myhostname = @@HOSTNAME@@
myorigin = $myhostname
mydestination = localhost
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
recipient_delimiter = +
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# --- limits -----------------------------------------------------------------
message_size_limit = @@MESSAGE_SIZE_LIMIT@@
mailbox_size_limit = 0
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
smtpd_client_connection_count_limit = 50
anvil_rate_time_unit = 60s
smtpd_error_sleep_time = 1s
smtpd_soft_error_limit = 10
smtpd_hard_error_limit = 20

# --- virtual mail: domains, mailboxes and aliases come from the mail database ----
virtual_mailbox_domains = proxy:mysql:/etc/postfix/sql/virtual-domains.cf
virtual_mailbox_maps    = proxy:mysql:/etc/postfix/sql/virtual-mailboxes.cf
virtual_alias_maps      = proxy:mysql:/etc/postfix/sql/virtual-aliases.cf
virtual_transport       = lmtp:unix:private/dovecot-lmtp
smtpd_sender_login_maps = proxy:mysql:/etc/postfix/sql/sender-login.cf
smtpd_reject_unlisted_recipient = yes

# --- TLS (inbound) --------------------------------------------------------------
smtpd_tls_cert_file = @@TLS_CERT@@
smtpd_tls_key_file = @@TLS_KEY@@
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = medium
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
smtpd_tls_session_cache_database = lmdb:${data_directory}/smtpd_scache
# --- TLS (outbound): opportunistic, because many servers on the internet are old ---
smtp_tls_security_level = may
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_loglevel = 1
smtp_tls_session_cache_database = lmdb:${data_directory}/smtp_scache

# --- authentication (Dovecot SASL) ------------------------------------------------
# SASL is switched on only for the submission ports in master.cf.
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_security_options = noanonymous

# --- anti-abuse ----------------------------------------------------------------------
disable_vrfy_command = yes
smtpd_helo_required = yes
smtpd_delay_reject = yes
smtpd_client_restrictions = permit_mynetworks
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname
smtpd_sender_restrictions = permit_mynetworks, reject_non_fqdn_sender, reject_unknown_sender_domain
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
# The quota check runs before permit_mynetworks so that local senders cannot bypass it either.
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unknown_recipient_domain, check_policy_service unix:private/quota-status, permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_data_restrictions = reject_unauth_pipelining

# postscreen (port 25 only). DNSBLs are intentionally NOT enabled by default: they need
# a local recursive resolver (public resolvers get blocked by the list operators and
# cause false positives). Enable them in /etc/kloxo/mail.d/postfix-main.cf if you run one.
postscreen_access_list = permit_mynetworks
postscreen_greet_action = enforce
postscreen_blacklist_action = drop
postscreen_cache_map = lmdb:${data_directory}/postscreen_cache

# --- spam / DKIM / DMARC: Rspamd through the milter protocol --------------------------
milter_protocol = 6
milter_default_action = tempfail
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = $smtpd_milters
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
