# Per-domain access/error logs. Raw logs stay on disk, never in SQLite.
/var/log/kloxo/domains/*/access.log
/var/log/kloxo/domains/*/error.log
{
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0640 www-data www-data
    postrotate
        /usr/bin/systemctl reload nginx >/dev/null 2>&1 || true
        /usr/bin/systemctl reload apache2 >/dev/null 2>&1 || true
    endscript
}
