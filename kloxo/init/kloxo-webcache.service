[Unit]
Description=Kloxo CP webcache (nginx on 8080)
Documentation=https://kloxocp.invalid/
After=network.target nginx.service
Wants=nginx.service

[Service]
Type=forking
PIDFile=/run/kloxo-webcache.pid
ExecStartPre=/usr/sbin/nginx -t -c /opt/kloxo/etc/webfront/webcache.conf
ExecStart=/usr/sbin/nginx -c /opt/kloxo/etc/webfront/webcache.conf
ExecReload=/usr/sbin/nginx -c /opt/kloxo/etc/webfront/webcache.conf -s reload
ExecStop=/usr/sbin/nginx -c /opt/kloxo/etc/webfront/webcache.conf -s quit
Restart=on-failure
PrivateTmp=true

[Install]
WantedBy=multi-user.target
