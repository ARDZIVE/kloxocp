[Unit]
Description=Startup script for Kloxo CP.
Documentation=https://kloxocp.invalid/
After=network.target remote-fs.target nss-lookup.target
 
[Service]
Type=simple
PIDFile=/opt/kloxo/init/kloxo-phpcgi.pid
ExecStart=/opt/kloxo/init/kloxo-php-fpm.sh
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s QUIT $MAINPID
PrivateTmp=true
 
[Install]
WantedBy=multi-user.target