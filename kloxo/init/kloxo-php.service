[Unit]
Description=Kloxo CP panel PHP-FPM
Documentation=https://kloxocp.invalid/
After=network.target remote-fs.target nss-lookup.target

[Service]
Type=simple
PIDFile=/opt/kloxo/init/kloxo-phpcgi.pid
ExecStart=/opt/kloxo/init/kloxo-php-fpm.sh
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
Restart=on-failure
PrivateTmp=true

[Install]
WantedBy=multi-user.target
