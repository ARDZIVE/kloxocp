[Unit]
Description=Kloxo CP panel web server (Hiawatha)
Documentation=https://kloxocp.invalid/
After=network.target kloxo-php.service
Wants=kloxo-php.service

[Service]
Type=simple
ExecStart=/opt/kloxo/init/kloxo-hiawatha -d -c /opt/kloxo/init
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
PrivateTmp=true

[Install]
WantedBy=multi-user.target
