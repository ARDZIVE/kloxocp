#!/bin/sh
# Enable a systemd unit (Ubuntu). CentOS chkconfig fallback removed.
echo "*** Process for enable service ***"
if [ -z "${1}" ]; then
	echo "- Format: ${0} <servicename>"
	exit 1
fi
echo "- Enable '${1}' service"
if ! command -v systemctl >/dev/null 2>&1; then
	echo "error: systemctl required"
	exit 1
fi
systemctl enable "${1}" >/dev/null 2>&1 || true
systemctl daemon-reload >/dev/null 2>&1 || true
if [ -n "${2}" ]; then
	systemctl "${2}" "${1}.service" 2>/dev/null || true
fi
