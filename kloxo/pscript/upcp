#!/bin/sh
# Kloxo CP upcp — cPanel-style panel update with automatic rollback on failure.
#
#   sudo sh /script/upcp
#   sudo sh /script/upcp --check
#   sudo sh /script/upcp --no-fetch
#
# Same as: sudo kloxocp update …
set -eu
ROOT="${KLOXO_ROOT:-/opt/kloxo}"
BIN="${ROOT}/bin/kloxocp"
PHP=""

if [ ! -x "$BIN" ] && [ -f "$BIN" ]; then
	chmod +x "$BIN" || true
fi
if [ ! -f "$BIN" ]; then
	echo "error: $BIN not found (is Kloxo CP installed?)" >&2
	exit 1
fi
if [ "$(id -u)" -ne 0 ]; then
	echo "error: Must run as root: sudo sh /script/upcp" >&2
	exit 1
fi

# Prefer pinned panel PHP (pdo_sqlite) over a PHP Used /usr/bin/php.
if [ -n "${KLOXO_PHP:-}" ] && [ -x "${KLOXO_PHP}" ]; then
	PHP="${KLOXO_PHP}"
elif [ -x "${ROOT}/init/php-cli.sh" ]; then
	PHP="${ROOT}/init/php-cli.sh"
elif [ -f "${ROOT}/etc/path/php" ]; then
	PIN="$(tr -d '\n\r' < "${ROOT}/etc/path/php" 2>/dev/null || true)"
	if [ -n "${PIN}" ] && [ -x "${PIN}" ]; then
		PHP="${PIN}"
	fi
fi
PHP="${PHP:-php}"

exec "$PHP" "$BIN" upcp "$@"
