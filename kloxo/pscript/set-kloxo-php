#/bin/sh

#!/bin/sh

if [ "$1" == "--help" ] || [ "$1" == "-h" ] ; then
	echo
	echo " ------------------------------------------------------------------------------"
	echo "  format: sh $0 <fpm/cgi> <phpXYs>"
	echo " ------------------------------------------------------------------------------"
	echo
	exit
fi

echo
echo "- For help, type '$0 --help'"

if [ "$#" == 0 ] ; then
	echo "- No argument supplied. Defaulting to 'fpm' and 'php56s'"
	echo
fi

if [ "${1}" == 'cgi' ] ; then
	echo '' > /opt/kloxo/init/kloxo_use_php-cgi
else
	if [ -f /opt/kloxo/init/kloxo_use_php-cgi ] ; then
		'rm' -f /opt/kloxo/init/kloxo_use_php-cgi
	fi
fi

# Passwordless sudo for the web-facing lxlabs account was removed (audit H6).

if [ "${2}" == "" ] ; then
	echo "- No php selected. Defaulting to 'php56s'"
	echo
	echo "php56s" > /opt/kloxo/init/kloxo_php_active
else
	sh /script/phpm-installer ${2}
	echo "${2}" > /opt/kloxo/init/kloxo_php_active
fi

sh /script/restart -y