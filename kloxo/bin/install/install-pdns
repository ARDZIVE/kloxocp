#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * install-pdns: prepare PowerDNS next to BIND on Ubuntu 24.04 / 26.x.
 *
 * Copyright (C) 2026 Kloxo CP contributors
 * GNU Affero General Public License v3. See LICENSE.txt.
 *
 * BIND stays the default (enabled, listening on 53). PowerDNS is installed,
 * given a MariaDB schema and a gmysql snippet, and left disabled until
 * Switch Program selects pdns.
 *
 * Standalone: no legacy panel includes. PHP 8.3, PDO / mariadb CLI unix_socket,
 * argument-array proc_open, no shell strings. Does not enable or start pdns.
 *
 * Usage:
 *   install-pdns --root=DIR [--etc=DIR] [--dry-run] [--force]
 */

const IPDNS_VERSION = '0.1.0';

final class IpdnsException extends RuntimeException
{
}

final class Proc
{
    /** @param list<string> $cmd */
    public static function run(array $cmd, ?string $stdin = null): array
    {
        $p = @proc_open($cmd, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
        if (!is_resource($p)) {
            return [127, '', 'cannot execute ' . ($cmd[0] ?? '')];
        }
        if ($stdin !== null) {
            fwrite($pipes[0], $stdin);
        }
        fclose($pipes[0]);
        $out = stream_get_contents($pipes[1]);
        $err = stream_get_contents($pipes[2]);
        fclose($pipes[1]);
        fclose($pipes[2]);

        return [proc_close($p), (string)$out, (string)$err];
    }

    public static function exists(string $bin): bool
    {
        foreach (explode(':', (string)getenv('PATH') . ':/usr/sbin:/usr/bin:/bin') as $d) {
            if ($d !== '' && is_executable($d . '/' . $bin)) {
                return true;
            }
        }

        return false;
    }
}

final class App
{
    /** @var array<string,string|true> */
    private array $opt = [];
    private string $root = '/opt/kloxo';
    private string $etc = '/etc/powerdns';

    public function run(array $argv): int
    {
        array_shift($argv);
        foreach ($argv as $a) {
            if ($a === '--help' || $a === '-h') {
                return $this->help();
            }
            if ($a === '--version') {
                echo 'install-pdns ' . IPDNS_VERSION . "\n";
                return 0;
            }
            if ($a === '--dry-run') {
                $this->opt['dry-run'] = true;
                continue;
            }
            if ($a === '--print-local-address') {
                $this->opt['print-local-address'] = true;
                continue;
            }
            if ($a === '--fix-bind-settings') {
                $this->opt['fix-bind-settings'] = true;
                continue;
            }
            if ($a === '--force') {
                $this->opt['force'] = true;
                continue;
            }
            if (str_starts_with($a, '--') && str_contains($a, '=')) {
                [$k, $v] = explode('=', substr($a, 2), 2);
                $this->opt[$k] = $v;
                continue;
            }
            throw new IpdnsException("Unknown argument: $a");
        }
        $this->root = $this->optRoot();
        $this->etc = $this->optEtc();
        if (isset($this->opt['dry-run'])) {
            echo "plan: install-pdns {$this->root}\n";
            echo "  packages pdns-server pdns-backend-mysql (not started)\n";
            echo "  schema   powerdns MariaDB + /etc/powerdns/pdns.d/zz-kloxo-gmysql.conf\n";
            echo "  default  bind9 stays enabled; pdns stays disabled\n";
            return 0;
        }

        if (isset($this->opt['print-local-address'])) {
            $line = $this->localAddressLine();
            echo $line === '' ? "(wildcard: no local-address needed)\n" : $line . "\n";
            return 0;
        }
        if (isset($this->opt['fix-bind-settings'])) {
            $n = count($this->disableBindBackendSettings());
            echo $n === 0 ? "no BIND backend settings found\n" : "fixed $n file(s)\n";
            return 0;
        }

        return $this->install();
    }

    private function help(): int
    {
        echo <<<TXT
install-pdns 0.1.0: prepare PowerDNS beside BIND (BIND stays default)

  install-pdns --root=DIR [--etc=DIR] [--force]
  install-pdns --dry-run --root=DIR
  install-pdns --fix-bind-settings [--etc=DIR]   only the bind-config clean-up
  install-pdns --print-local-address             show the local-address setting it would write
  install-pdns --help

Installs pdns-server and pdns-backend-mysql if missing, creates the
powerdns MariaDB schema, writes /etc/powerdns/pdns.d/zz-kloxo-gmysql.conf,
and leaves the pdns unit disabled. Switch Program can then select pdns.
Leftover BIND-backend settings (bind-config, launch=bind) in pdns.conf or
pdns.d/*.conf are switched off, because pdns refuses to start with
"Trying to set unknown setting 'bind-config'" when that backend is not installed.
--etc=DIR is the PowerDNS config directory (default /etc/powerdns).

TXT;
        return 0;
    }

    private function optRoot(): string
    {
        $root = isset($this->opt['root']) && $this->opt['root'] !== true
            ? (string)$this->opt['root'] : (string)(getenv('KLOXO_ROOT') ?: '/opt/kloxo');
        if ($root === '' || str_contains($root, "\0") || str_contains($root, '..')) {
            throw new IpdnsException('Invalid --root');
        }

        return rtrim($root, '/');
    }

    private function optEtc(): string
    {
        $etc = isset($this->opt['etc']) && $this->opt['etc'] !== true
            ? (string)$this->opt['etc'] : '/etc/powerdns';
        if ($etc === '' || $etc[0] !== '/' || str_contains($etc, "\0") || str_contains($etc, '..')) {
            throw new IpdnsException('Invalid --etc');
        }

        return rtrim($etc, '/');
    }

    private function install(): int
    {
        $this->copyTree();
        $pass = $this->ensurePass();
        $this->ensureSchema($pass);
        $this->writeConf($pass);
        $this->disableBindBackendSettings();
        $this->keepPdnsDisabled();
        echo "pdns ready (disabled); BIND remains the default DNS server\n";
        return 0;
    }

    private function copyTree(): void
    {
        $src = $this->root . '/file/pdns';
        $dst = '/opt/configs/pdns';
        if (!is_dir($src)) {
            throw new IpdnsException("missing $src");
        }
        if (!is_dir('/opt/configs') && !mkdir('/opt/configs', 0755, true) && !is_dir('/opt/configs')) {
            throw new IpdnsException('Cannot create /opt/configs');
        }
        [$rc, $out, $err] = Proc::run(['rsync', '-a', $src . '/', $dst . '/']);
        if ($rc !== 0) {
            throw new IpdnsException('rsync pdns templates failed: ' . trim($err . ' ' . $out));
        }
        foreach (array('conf/master', 'conf/slave', 'conf/reverse', 'tpl') as $sub) {
            $d = $dst . '/' . $sub;
            if (!is_dir($d)) {
                mkdir($d, 0755, true);
            }
        }
    }

    private function ensurePass(): string
    {
        $file = $this->root . '/etc/conf/pdns.pass';
        $dir = dirname($file);
        if (!is_dir($dir) && !mkdir($dir, 0750, true) && !is_dir($dir)) {
            throw new IpdnsException("Cannot create $dir");
        }
        $force = isset($this->opt['force']);
        if (!$force && is_readable($file)) {
            $cur = trim((string)file_get_contents($file));
            if ($cur !== '') {
                return $cur;
            }
        }
        $pass = bin2hex(random_bytes(12));
        if (file_put_contents($file, $pass . "\n") === false) {
            throw new IpdnsException("Cannot write $file");
        }
        chmod($file, 0640);
        if (function_exists('posix_getpwnam') && posix_getpwnam('lxlabs') !== false) {
            @chown($file, 'lxlabs');
            @chgrp($file, 'lxlabs');
        }

        return $pass;
    }

    private function ensureSchema(string $pass): void
    {
        $bin = Proc::exists('mariadb') ? 'mariadb' : (Proc::exists('mysql') ? 'mysql' : '');
        if ($bin === '') {
            throw new IpdnsException('MariaDB client not in PATH');
        }
        $q = "'" . str_replace(array("\\", "'"), array("\\\\", "\\'"), $pass) . "'";
        $sql = "CREATE DATABASE IF NOT EXISTS `powerdns` CHARACTER SET latin1;\n"
            . "CREATE USER IF NOT EXISTS 'powerdns'@'localhost' IDENTIFIED BY {$q};\n"
            . "ALTER USER 'powerdns'@'localhost' IDENTIFIED BY {$q};\n"
            . "GRANT ALL PRIVILEGES ON `powerdns`.* TO 'powerdns'@'localhost';\n"
            . "FLUSH PRIVILEGES;\n";
        $cmd = [$bin, '--protocol=socket', '-u', 'root'];
        foreach (array(
            '/run/mysqld/mysqld.sock',
            '/run/mysqld/mariadb.sock',
            '/var/run/mysqld/mysqld.sock',
        ) as $sock) {
            if (file_exists($sock)) {
                $cmd[] = '--socket=' . $sock;
                break;
            }
        }
        [$rc, $out, $err] = Proc::run($cmd, $sql);
        if ($rc !== 0) {
            throw new IpdnsException("powerdns user failed: " . trim($err . ' ' . $out));
        }
        $schema = $this->root . '/file/pdns/tpl/pdns.sql';
        if (!is_readable($schema)) {
            throw new IpdnsException("missing $schema");
        }
        $body = (string)file_get_contents($schema);
        $body = preg_replace('/^\s*CREATE\s+DATABASE.*$/mi', '', $body) ?? $body;
        $body = preg_replace('/^\s*USE\s+`?powerdns`?\s*;?\s*$/mi', '', $body) ?? $body;
        $cmdUse = $cmd;
        $cmdUse[] = 'powerdns';
        [$rc, $out, $err] = Proc::run($cmdUse, $body);
        if ($rc !== 0) {
            throw new IpdnsException("powerdns schema failed: " . trim($err . ' ' . $out));
        }
    }

    private function writeConf(string $pass): void
    {
        $dir = $this->etc . '/pdns.d';
        if (!is_dir($dir) && $this->etc === '/etc/powerdns') {
            $dir = '/etc/pdns';
        }
        if (!is_dir($dir) && !mkdir($dir, 0755, true) && !is_dir($dir)) {
            throw new IpdnsException("Cannot create $dir");
        }
        $file = $dir === '/etc/pdns'
            ? '/etc/pdns/pdns.conf'
            : $dir . '/zz-kloxo-gmysql.conf';
        if (preg_match('/[\r\n#]/', $pass) === 1) {
            throw new IpdnsException('Invalid pdns password');
        }
        $body = "# Generated by Kloxo CP install-pdns. Do not commit.\n"
            . "launch=gmysql\n"
            . "gmysql-host=127.0.0.1\n"
            . "gmysql-user=powerdns\n"
            . "gmysql-password={$pass}\n"
            . "gmysql-dbname=powerdns\n";
        $addr = $this->localAddressLine();
        if ($addr !== '') {
            $body .= "# systemd-resolved listens on 127.0.0.53 / 127.0.0.54 port 53: a wildcard bind\n"
                . "# (the pdns default 0.0.0.0) fails with 'Address already in use'.\n"
                . $addr . "\n";
        }
        $tmp = $file . '.tmp.' . getmypid();
        if (file_put_contents($tmp, $body) === false) {
            throw new IpdnsException("Cannot write $tmp");
        }
        chmod($tmp, 0640);
        if (!rename($tmp, $file)) {
            @unlink($tmp);
            throw new IpdnsException("Cannot install $file");
        }
        if (function_exists('posix_getpwnam') && posix_getpwnam('pdns') !== false) {
            @chown($file, 'pdns');
            @chgrp($file, 'pdns');
        }
        if (Proc::exists('pdns_server')) {
            [$rc, $out, $err] = Proc::run(['pdns_server', '--config-check']);
            if ($rc !== 0) {
                fwrite(STDERR, "warn: pdns_server --config-check: " . trim($err . ' ' . $out) . "\n");
            }
        }
    }

    /**
     * Switch off BIND-backend settings left in the PowerDNS config. A package
     * conffile such as pdns.d/bind.conf survives removal of pdns-backend-bind and
     * then pdns exits with "Trying to set unknown setting 'bind-config'".
     * A pdns.d file that holds only such settings is renamed to *.kloxo-disabled
     * (pdns reads *.conf only); in other files the lines are commented out and a
     * .kloxo-bak copy of the original is kept.
     *
     * @return list<string> files changed
     */
    private function disableBindBackendSettings(): array
    {
        $files = [];
        if (is_file($this->etc . '/pdns.conf')) {
            $files[] = $this->etc . '/pdns.conf';
        }
        $g = glob($this->etc . '/pdns.d/*.conf');
        foreach ($g === false ? [] : $g as $f) {
            if (basename($f) !== 'zz-kloxo-gmysql.conf') {
                $files[] = $f;
            }
        }
        $changed = [];
        foreach ($files as $f) {
            $raw = @file_get_contents($f);
            if (!is_string($raw)) {
                continue;
            }
            $lines = preg_split('/\r\n|\n|\r/', $raw) ?: [];
            $bad = [];
            $other = 0;
            foreach ($lines as $i => $line) {
                $t = trim($line);
                if ($t === '' || $t[0] === '#' || $t[0] === ';') {
                    continue;
                }
                if (preg_match('/^bind-[a-z0-9-]+\s*=/i', $t) === 1
                    || preg_match('/^launch\s*\+?=.*\bbind\b/i', $t) === 1) {
                    $bad[] = $i;
                } else {
                    $other++;
                }
            }
            if ($bad === []) {
                continue;
            }
            if ($other === 0 && str_contains($f, '/pdns.d/')) {
                if (!@rename($f, $f . '.kloxo-disabled')) {
                    throw new IpdnsException("Cannot disable $f");
                }
            } else {
                if (!is_file($f . '.kloxo-bak') && !@copy($f, $f . '.kloxo-bak')) {
                    throw new IpdnsException("Cannot back up $f");
                }
                foreach ($bad as $i) {
                    $lines[$i] = '# disabled by Kloxo CP (BIND backend not installed): ' . $lines[$i];
                }
                $tmp = $f . '.tmp.' . getmypid();
                $perm = @fileperms($f);
                if (file_put_contents($tmp, implode("\n", $lines)) === false) {
                    throw new IpdnsException("Cannot write $tmp");
                }
                if ($perm !== false) {
                    @chmod($tmp, $perm & 0777);
                }
                if (!@rename($tmp, $f)) {
                    @unlink($tmp);
                    throw new IpdnsException("Cannot install $f");
                }
            }
            $changed[] = $f;
            echo "disabled BIND backend settings in $f\n";
        }

        return $changed;
    }

    /**
     * `local-address=...` when something already listens on port 53 on a 127.0.0.x
     * address other than 127.0.0.1 (systemd-resolved's stub on Ubuntu). pdns binds
     * 0.0.0.0 by default and a wildcard bind cannot coexist with that listener, while
     * BIND binds addresses one by one and can. Then pdns is told to use 127.0.0.1 and
     * the server's global IPv4 addresses instead. Empty string: leave the default.
     */
    private function localAddressLine(): string
    {
        if (!Proc::exists('ss')) {
            return '';
        }
        [$rc, $out] = Proc::run(['ss', '-H', '-l', '-n', '-u', '-t', 'sport', '=', ':53']);
        if ($rc !== 0) {
            return '';
        }
        $stub = false;
        foreach (preg_split('/\R/', $out) ?: [] as $l) {
            $f = preg_split('/\s+/', trim($l)) ?: [];
            if (count($f) >= 5 && preg_match('/^127\.(\d+)\.(\d+)\.(\d+)(%\w+)?:53$/', $f[4], $m) === 1
                && $f[4] !== '127.0.0.1:53' && !str_starts_with($f[4], '127.0.0.1%')) {
                $stub = true;
            }
        }
        if (!$stub || !Proc::exists('ip')) {
            return '';
        }
        [$rc, $out] = Proc::run(['ip', '-4', '-o', 'addr', 'show', 'scope', 'global']);
        $addrs = ['127.0.0.1'];
        if ($rc === 0) {
            foreach (preg_split('/\R/', $out) ?: [] as $l) {
                if (preg_match('/\binet\s+(\d{1,3}(?:\.\d{1,3}){3})\//', $l, $m) === 1
                    && filter_var($m[1], FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false) {
                    $addrs[] = $m[1];
                }
            }
        }

        return 'local-address=' . implode(', ', array_values(array_unique($addrs)));
    }

    private function keepPdnsDisabled(): void
    {
        if (!Proc::exists('systemctl')) {
            return;
        }
        Proc::run(['systemctl', 'reset-failed', 'pdns']);
        Proc::run(['systemctl', 'disable', '--now', 'pdns']);
    }
}

try {
    exit((new App())->run($argv));
} catch (IpdnsException $e) {
    fwrite(STDERR, 'error: ' . $e->getMessage() . "\n");
    exit(1);
}
