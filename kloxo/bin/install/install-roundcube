#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * install-roundcube: install and wire Roundcube for Kloxo CP webmail.
 *
 * Copyright (C) 2026 Kloxo CP contributors
 * GNU Affero General Public License v3 or later. See LICENSE.txt.
 *
 * Ubuntu: apt packages roundcube + roundcube-mysql, MariaDB database,
 * docroot symlink at /home/kloxo/httpd/webmail/roundcube, IMAP/SMTP to
 * local Dovecot/Exim, and the shared PHP-FPM socket used by nginx
 * (/opt/configs/php-fpm/sock/php-www-data.sock -> distro phpX.Y-fpm.sock).
 *
 * Usage:
 *   install-roundcube --root=DIR [--dry-run]
 */

$root = '/opt/kloxo';
$dry = false;
foreach (array_slice($argv, 1) as $a) {
	if ($a === '--help' || $a === '-h') {
		echo "install-roundcube --root=DIR [--dry-run]\n"
			. "  Install Roundcube webmail and point Kloxo nginx docroot at it.\n";
		exit(0);
	}
	if ($a === '--dry-run') {
		$dry = true;
	} elseif (str_starts_with($a, '--root=')) {
		$root = rtrim(substr($a, 7), '/');
	} else {
		fwrite(STDERR, "error: unknown option $a\n");
		exit(64);
	}
}

$lib = $root . '/httpdocs/lib/php/kloxo_roundcube.php';
if ($root === '' || $root[0] !== '/' || !is_file($lib)) {
	fwrite(STDERR, "error: not a Kloxo program root: $root\n");
	exit(1);
}
putenv('KLOXO_ROOT=' . $root);
require_once $lib;

try {
	if ($dry) {
		$plan = KloxoRoundcube::plan();
		echo "would: " . implode('; ', $plan) . "\n";
		exit(0);
	}
	$msg = KloxoRoundcube::install();
	echo $msg . "\n";
	exit(0);
} catch (Throwable $e) {
	fwrite(STDERR, 'error: ' . $e->getMessage() . "\n");
	exit(1);
}
