#!/bin/bash
# Install phpMyAdmin under the panel WebsiteRoot so Hiawatha can serve it.
#
# Hiawatha returns 405 for a directory with no index file, and it will not
# follow Debian's vendor JS symlinks out of WebsiteRoot (jQuery 404 → login
# form stays CSS-hidden). Use the pinned all-languages tarball so js/vendor
# files are real files inside httpdocs. Apt phpmyadmin is a fallback only,
# copied with dereferenced symlinks.
#
# Copyright (C) 2026 Kloxo CP contributors
# GNU Affero General Public License v3. See LICENSE.txt.
set -euo pipefail

PMA_VERSION="5.2.3"
PMA_TARBALL="phpMyAdmin-${PMA_VERSION}-all-languages.tar.xz"
PMA_URL="https://files.phpmyadmin.net/phpMyAdmin/${PMA_VERSION}/${PMA_TARBALL}"
PMA_SHA_URL="${PMA_URL}.sha256"

ROOT="${KLOXO_ROOT:-/opt/kloxo}"
FORCE=0
DRY=0

usage() {
  cat <<EOF
install-phpmyadmin: put phpMyAdmin at <root>/httpdocs/thirdparty/phpMyAdmin

  sudo bash install-phpmyadmin [--root=DIR] [--force] [--dry-run]

  --root=DIR    program root (default: ${ROOT})
  --force       replace an existing copy
  --dry-run     print the plan and exit
  --help

Hiawatha 405 on /thirdparty/phpMyAdmin/ means that directory has no index.php.
A login page that only shows the logo means js/vendor is missing or a symlink
outside WebsiteRoot; this script reinstalls from the tarball in that case.
Do not commit the extracted tree.
EOF
}

log() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

digest() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    die "need sha256sum or shasum"
  fi
}

# True when Hiawatha can serve the JS that unhides the cookie-auth form.
vendor_js_ok() {
  local dest="$1"
  local f
  for f in \
    "$dest/js/vendor/jquery/jquery.min.js" \
    "$dest/js/vendor/bootstrap/bootstrap.bundle.min.js"
  do
    if [[ -L "$f" || ! -f "$f" ]]; then
      return 1
    fi
  done
  return 0
}

for a in "$@"; do
  case "$a" in
    --help|-h) usage; exit 0 ;;
    --force) FORCE=1 ;;
    --dry-run) DRY=1 ;;
    --root=*) ROOT="${a#--root=}" ;;
    *) die "unknown option: $a (try --help)" ;;
  esac
done

if [[ "$ROOT" == *..* || "$ROOT" == *$'\n'* ]]; then
  die "invalid --root"
fi

DEST="$ROOT/httpdocs/thirdparty/phpMyAdmin"
CONF_TMPL="$ROOT/file/phpmyadmin/config.inc.php"

if [[ "$DRY" -eq 1 ]]; then
  cat <<EOF
plan: install phpMyAdmin ${PMA_VERSION}
  dest     $DEST
  primary  $PMA_URL
  fallback apt phpmyadmin (dereferenced copy)
  force    $FORCE
EOF
  exit 0
fi

[[ "$(id -u)" -eq 0 ]] || die "run as root (sudo bash install-phpmyadmin)"
[[ -d "$ROOT/httpdocs" && -f "$CONF_TMPL" ]] || die "$ROOT is not a Kloxo program root"

write_config() {
  local dest="$1"
  local secret tmpdir conf
  secret="$(openssl rand -base64 48 | tr -d '\n+/=' )"
  secret="${secret:0:48}"
  [[ ${#secret} -ge 32 ]] || die "could not generate blowfish secret"
  tmpdir="$dest/tmp"
  mkdir -p "$tmpdir"
  chmod 0700 "$tmpdir"
  conf="$dest/config.inc.php"
  sed -e "s/KLOXO_BLOWFISH_SECRET/${secret}/g" \
      -e "s|KLOXO_PMA_TEMP|${tmpdir}|g" \
      "$CONF_TMPL" > "$conf"
  chmod 0640 "$conf"
  if [[ -f "$ROOT/file/phpmyadmin/kloxo-signon.php" ]]; then
    install -m 0644 "$ROOT/file/phpmyadmin/kloxo-signon.php" "$dest/kloxo-signon.php"
  fi
  if [[ -f "$ROOT/file/phpmyadmin/kloxo-signon-script.php" ]]; then
    install -m 0644 "$ROOT/file/phpmyadmin/kloxo-signon-script.php" "$dest/kloxo-signon-script.php"
  fi
  if id -u lxlabs >/dev/null 2>&1; then
    chown -R lxlabs:lxlabs "$dest"
  fi
}

if [[ "$FORCE" -eq 0 && -f "$DEST/index.php" ]] && vendor_js_ok "$DEST"; then
  log "phpMyAdmin already present at $DEST; writing config (pass --force to replace)"
  write_config "$DEST"
  log "phpMyAdmin ready: /thirdparty/phpMyAdmin/"
  exit 0
fi

if [[ -f "$DEST/index.php" ]] && ! vendor_js_ok "$DEST"; then
  log "phpMyAdmin vendor JS is missing or a symlink; reinstalling a self-contained copy"
fi

apt-get install -y --no-install-recommends php-mysql php-mbstring php-xml php-curl php-zip || true

SRC=""
mkdir -p /usr/local/src
tarball="/usr/local/src/$PMA_TARBALL"
log "downloading $PMA_URL"
if curl -fsSL --retry 3 -o "$tarball" "$PMA_URL" \
  && curl -fsSL --retry 3 -o "$tarball.sha256" "$PMA_SHA_URL"; then
  expect="$(awk '{print $1}' "$tarball.sha256")"
  [[ "$expect" =~ ^[a-fA-F0-9]{64}$ ]] || die "checksum file is not a sha256"
  got="$(digest "$tarball")"
  [[ "$got" == "$expect" ]] || die "sha256 mismatch ($got != $expect)"
  extract="/usr/local/src/phpMyAdmin-${PMA_VERSION}-all-languages"
  rm -rf "$extract"
  tar -xJf "$tarball" -C /usr/local/src
  [[ -f "$extract/index.php" ]] || die "tarball did not contain index.php"
  SRC="$extract"
else
  log "tarball download failed; trying apt phpmyadmin with dereferenced copy"
  echo 'phpmyadmin phpmyadmin/reconfigure-webserver multiselect' | debconf-set-selections
  echo 'phpmyadmin phpmyadmin/dbconfig-install boolean false' | debconf-set-selections
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends phpmyadmin \
    || die "download failed and apt phpmyadmin is not available"
  [[ -f /usr/share/phpmyadmin/index.php ]] || die "apt phpmyadmin has no index.php"
  SRC=/usr/share/phpmyadmin
fi

rm -rf "$DEST"
mkdir -p "$(dirname "$DEST")"
# -L: Debian vendor JS is a symlink into /usr/share/javascript; Hiawatha will
# not serve those, so copy the real files into WebsiteRoot.
if ! cp -aL "$SRC" "$DEST" 2>/dev/null; then
  cp -a "$SRC" "$DEST"
fi
rm -rf "$DEST/setup"
if ! vendor_js_ok "$DEST"; then
  die "phpMyAdmin js/vendor/jquery.min.js is missing after install"
fi
write_config "$DEST"
mkdir -p "$ROOT/session"
if id -u lxlabs >/dev/null 2>&1; then
  chown lxlabs:lxlabs "$ROOT/session" || true
fi
log "phpMyAdmin ready: /thirdparty/phpMyAdmin/"
exit 0
