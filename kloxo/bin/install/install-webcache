#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * install-webcache: Nginx proxy cache in front of the site web server
 * (Nginx or Apache), or back to the plain 8080 side cache.
 *
 * Copyright (C) 2026 Kloxo CP contributors
 * GNU Affero General Public License v3. See LICENSE.txt.
 *
 *   --mode=front  cache listens on 80/443 (+8080); the site server (already
 *                 regenerated by fixweb with webcache != none) listens on
 *                 127.0.0.1:8081 (http) and 127.0.0.1:8444 (https, TLS).
 *   --mode=none   restore the side cache (8080 -> 127.0.0.1:80); the site
 *                 server owns 80/443 again.
 *
 * Config is rendered, validated with nginx -t, installed atomically and
 * rolled back from an in-memory snapshot on failure. Argument-array process
 * execution only. HTTPS is terminated in the cache with the certificate the
 * site already uses (one record per domain under etc/webfront/domains).
 *
 * Usage:
 *   install-webcache --mode=front|none [--root=DIR] [--ttl=SECONDS] [--dry-run]
 */

const IWCACHE_VERSION = '0.1.0';
const IWCACHE_BACK_HTTP = 8081;
const IWCACHE_BACK_HTTPS = 8444;
const IWCACHE_MARK = '# Generated by Kloxo CP install-webcache. Do not edit by hand.';

final class IwcacheException extends RuntimeException
{
}

final class Proc
{
    /** @param list<string> $cmd @return array{0:int,1:string,2:string} */
    public static function run(array $cmd): array
    {
        $p = @proc_open($cmd, [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
        if (!is_resource($p)) {
            return [127, '', 'cannot execute ' . ($cmd[0] ?? '')];
        }
        $out = stream_get_contents($pipes[1]);
        $err = stream_get_contents($pipes[2]);
        fclose($pipes[1]);
        fclose($pipes[2]);

        return [proc_close($p), (string)$out, (string)$err];
    }

    public static function exists(string $bin): bool
    {
        foreach (explode(':', (string)getenv('PATH') . ':/usr/sbin:/usr/bin:/bin') as $d) {
            if ($d !== '' && is_executable($d . '/' . $bin)) {
                return true;
            }
        }

        return false;
    }
}

final class App
{
    /** @var array<string,string|true> */
    private array $opt = [];
    private string $root = '/opt/kloxo';
    /** @var array<string,?string> path => previous content (null = absent) */
    private array $snap = [];

    public function run(array $argv): int
    {
        array_shift($argv);
        foreach ($argv as $a) {
            if ($a === '--help' || $a === '-h') {
                return $this->help();
            }
            if ($a === '--version') {
                echo 'install-webcache ' . IWCACHE_VERSION . "\n";

                return 0;
            }
            if ($a === '--dry-run' || $a === '--no-health' || $a === '--check-backends') {
                $this->opt[substr($a, 2)] = true;
                continue;
            }
            if (str_starts_with($a, '--') && str_contains($a, '=')) {
                [$k, $v] = explode('=', substr($a, 2), 2);
                $this->opt[$k] = $v;
                continue;
            }
            throw new IwcacheException("Unknown argument: $a");
        }
        $mode = (string)($this->opt['mode'] ?? '');
        if ($mode !== 'front' && $mode !== 'none') {
            throw new IwcacheException('--mode=front|none is required');
        }
        $this->root = $this->path('root', (string)(getenv('KLOXO_ROOT') ?: '/opt/kloxo'));
        if (isset($this->opt['dry-run'])) {
            return $this->plan($mode);
        }

        return $mode === 'front' ? $this->front() : $this->none();
    }

    private function help(): int
    {
        echo <<<TXT
install-webcache 0.1.0: Nginx proxy cache for Nginx or Apache sites

  install-webcache --mode=front [--root=DIR] [--ttl=60]
  install-webcache --mode=none  [--root=DIR]
  install-webcache --mode=front --dry-run

front: cache on 80/443/8080, site server on 127.0.0.1:8081 (http) and
       127.0.0.1:8444 (https). Run fixweb first so the site server config uses
       those ports.
none:  side cache on 8080, site server back on 80/443.

TXT;

        return 0;
    }

    private function path(string $key, string $default): string
    {
        $v = isset($this->opt[$key]) && $this->opt[$key] !== true ? (string)$this->opt[$key] : $default;
        if ($v === '' || str_contains($v, "\0") || str_contains($v, '..') || $v[0] !== '/') {
            throw new IwcacheException("Invalid --$key");
        }

        return rtrim($v, '/') === '' ? '/' : rtrim($v, '/');
    }

    private function confDir(): string
    {
        return $this->path('conf-dir', $this->root . '/etc/webfront');
    }

    private function sslDir(): string
    {
        return $this->path('ssl-dir', '/home/kloxo/ssl');
    }

    private function nginxConfD(): string
    {
        return $this->path('nginx-confd', '/etc/nginx/conf.d');
    }

    private function apacheDir(): string
    {
        return $this->path('apache-dir', '/etc/apache2');
    }

    private function flagFile(): string
    {
        return $this->path('flag-file', $this->root . '/etc/flag/webcache_front.flg');
    }

    private function ttl(): int
    {
        $t = isset($this->opt['ttl']) ? (string)$this->opt['ttl'] : '60';
        if (preg_match('/^[0-9]{1,5}$/', $t) !== 1 || (int)$t < 1) {
            throw new IwcacheException('Invalid --ttl');
        }

        return (int)$t;
    }

    private function plan(string $mode): int
    {
        echo "plan: install-webcache --mode=$mode {$this->root}\n";
        if ($mode === 'front') {
            echo "  cache    nginx on 80, 443, 8080 (kloxo-webcache.service)\n";
            echo '  backend  127.0.0.1:' . IWCACHE_BACK_HTTP . ' http, 127.0.0.1:' . IWCACHE_BACK_HTTPS . " https (TLS)\n";
            echo '  domains  ' . count($this->records()) . " record(s) with certificate\n";
        } else {
            echo "  cache    nginx on 8080 -> 127.0.0.1:80\n";
            echo "  backend  80/443 again\n";
        }

        return 0;
    }

    // ---- records -----------------------------------------------------------

    /** @return list<array{domain:string,names:list<string>,cert:string}> */
    public function records(): array
    {
        $dir = $this->path('records-dir', $this->root . '/etc/webfront/domains');
        $ssl = $this->sslDir();
        $out = [];
        $seen = [];
        $files = glob($dir . '/*.json') ?: [];
        sort($files);
        foreach ($files as $f) {
            $j = json_decode((string)@file_get_contents($f), true);
            if (!is_array($j) || !isset($j['domain'], $j['cert']) || !is_string($j['domain']) || !is_string($j['cert'])) {
                continue;
            }
            $domain = strtolower($j['domain']);
            if (!self::validName($domain)) {
                continue;
            }
            $cert = $j['cert'];
            if (!str_starts_with($cert, $ssl . '/') || preg_match('#^[A-Za-z0-9/._-]+$#', $cert) !== 1
                || str_contains($cert, '..')) {
                continue;
            }
            if (!is_file($cert . '.pem') || !is_file($cert . '.key')) {
                continue;
            }
            $names = [];
            foreach (array_merge([$domain], is_array($j['names'] ?? null) ? $j['names'] : []) as $n) {
                $n = strtolower((string)$n);
                if (self::validName($n) && !isset($seen[$n])) {
                    $seen[$n] = true;
                    $names[] = $n;
                }
            }
            if ($names !== []) {
                $out[] = ['domain' => $domain, 'names' => $names, 'cert' => $cert];
            }
        }

        return $out;
    }

    public static function validName(string $n): bool
    {
        return strlen($n) <= 253 && preg_match('/^(\*\.)?[a-z0-9]([a-z0-9._-]*[a-z0-9])?$/', $n) === 1
            && !str_contains($n, '..');
    }

    // ---- rendering -----------------------------------------------------------

    private function ipv6(): bool
    {
        return isset($this->opt['ipv6'])
            ? $this->opt['ipv6'] === '1'
            : (is_file('/proc/net/if_inet6') && filesize('/proc/net/if_inet6') > 0);
    }

    private function nginxVersion(): string
    {
        if (isset($this->opt['nginx-version']) && $this->opt['nginx-version'] !== true) {
            return (string)$this->opt['nginx-version'];
        }
        [, $o, $e] = Proc::run(['nginx', '-v']);
        if (preg_match('#nginx/([0-9.]+)#', $o . $e, $m) === 1) {
            return $m[1];
        }

        return '1.24.0';
    }

    private function proxyLocation(bool $https): string
    {
        $up = $https ? 'kloxo_back_https' : 'kloxo_back_http';
        $scheme = $https ? 'https' : 'http';
        $tls = $https
            ? "\t\t\tproxy_ssl_server_name on;\n\t\t\tproxy_ssl_name \$host;\n\t\t\tproxy_ssl_verify off;\n\t\t\tproxy_ssl_session_reuse on;\n"
            : '';
        $ttl = $this->ttl();

        return <<<LOC
		location / {
			proxy_pass {$scheme}://{$up};
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header Host \$host;
			proxy_set_header X-Real-IP \$remote_addr;
			proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto \$scheme;
			proxy_connect_timeout 60s;
			proxy_send_timeout 300s;
			proxy_read_timeout 300s;
			proxy_request_buffering off;
{$tls}			proxy_cache kloxocache;
			proxy_cache_key "\$scheme\$host\$request_uri";
			proxy_cache_valid 200 301 {$ttl}s;
			proxy_cache_lock on;
			proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
			proxy_cache_background_update on;
			proxy_cache_bypass \$kloxo_nocache;
			proxy_no_cache \$kloxo_nocache;
			add_header X-Kloxo-Cache \$upstream_cache_status always;
		}

LOC;
    }

    /** @param list<array{domain:string,names:list<string>,cert:string}> $records */
    public function renderFront(array $records, ?string $defaultCert): string
    {
        $v6 = $this->ipv6();
        $nv = $this->nginxVersion();
        $h2New = version_compare($nv, '1.25.1', '>=');
        $ssl = $this->sslDir();
        $http2Listen = $h2New ? '' : ' http2';
        $http2Dir = $h2New ? "\t\thttp2 on;\n" : '';

        $c = IWCACHE_MARK . "\n";
        $c .= "user www-data;\nworker_processes auto;\npid /run/kloxo-webcache.pid;\n";
        $c .= "error_log /var/log/kloxo/webcache.error.log;\n\n";
        $c .= "events {\n\tworker_connections 2048;\n}\n\n";
        $c .= "http {\n\tdefault_type application/octet-stream;\n\tserver_tokens off;\n";
        $c .= "\taccess_log /var/log/kloxo/webcache.access.log;\n";
        $c .= "\tclient_max_body_size 1024m;\n";
        $c .= "\tproxy_cache_path /var/cache/kloxo-webcache levels=1:2 keys_zone=kloxocache:32m max_size=512m inactive=60m use_temp_path=off;\n\n";
        $c .= "\t# Never cache sessions, logins, credentials or ACME challenges.\n";
        $c .= "\tmap \$http_cookie \$kloxo_nocache_cookie {\n\t\tdefault 0;\n";
        $c .= "\t\t\"~*(PHPSESSID|wordpress_logged_in|wp-postpass|comment_author|woocommerce_items_in_cart|woocommerce_cart_hash|wp_woocommerce_session|laravel_session|joomla_user_state|SESS[0-9a-f]{8})\" 1;\n\t}\n";
        $c .= "\tmap \$http_authorization \$kloxo_nocache_auth {\n\t\tdefault 1;\n\t\t\"\" 0;\n\t}\n";
        $c .= "\tmap \$request_uri \$kloxo_nocache_uri {\n\t\tdefault 0;\n";
        $c .= "\t\t\"~^/(wp-admin|wp-login\\.php|administrator|\\.well-known/)\" 1;\n\t}\n";
        $c .= "\tmap \"\$kloxo_nocache_cookie\$kloxo_nocache_auth\$kloxo_nocache_uri\" \$kloxo_nocache {\n\t\tdefault 1;\n\t\t\"000\" 0;\n\t}\n\n";
        $c .= '	upstream kloxo_back_http {' . "\n\t\tserver 127.0.0.1:" . IWCACHE_BACK_HTTP . ";\n\t\tkeepalive 32;\n\t}\n";
        $c .= '	upstream kloxo_back_https {' . "\n\t\tserver 127.0.0.1:" . IWCACHE_BACK_HTTPS . ";\n\t\tkeepalive 32;\n\t}\n\n";

        // plain HTTP (80) and the 8080 Watchdog port
        $c .= "\tserver {\n\t\tlisten 80 default_server;\n";
        if ($v6) {
            $c .= "\t\tlisten [::]:80 default_server;\n";
        }
        $c .= "\t\tlisten 8080;\n";
        if ($v6) {
            $c .= "\t\tlisten [::]:8080;\n";
        }
        $c .= "\t\tserver_name _;\n\n" . $this->proxyLocation(false) . "\t}\n\n";

        // HTTPS: default + one block per domain certificate
        if ($defaultCert !== null) {
            $sslCommon = "\t\tssl_protocols TLSv1.2 TLSv1.3;\n\t\tssl_session_cache shared:KLOXOSSL:10m;\n\t\tssl_session_timeout 1d;\n";
            $listen = static function (bool $default) use ($v6, $http2Listen): string {
                $d = $default ? ' default_server' : '';
                $s = "\t\tlisten 443 ssl{$http2Listen}{$d};\n";
                if ($v6) {
                    $s .= "\t\tlisten [::]:443 ssl{$http2Listen}{$d};\n";
                }

                return $s;
            };
            $c .= "\tserver {\n" . $listen(true) . $http2Dir . "\t\tserver_name _;\n";
            $c .= "\t\tssl_certificate {$defaultCert}.pem;\n\t\tssl_certificate_key {$defaultCert}.key;\n";
            $c .= $sslCommon . "\n" . $this->proxyLocation(true) . "\t}\n\n";
            foreach ($records as $r) {
                if (!str_starts_with($r['cert'], $ssl . '/')) {
                    continue;
                }
                $c .= "\t# {$r['domain']}\n\tserver {\n" . $listen(false) . $http2Dir;
                $c .= "\t\tserver_name " . implode(' ', $r['names']) . ";\n";
                $c .= "\t\tssl_certificate {$r['cert']}.pem;\n\t\tssl_certificate_key {$r['cert']}.key;\n";
                $c .= $sslCommon . "\n" . $this->proxyLocation(true) . "\t}\n\n";
            }
        }
        $c .= "}\n";

        return $c;
    }

    private function defaultCert(array $records): ?string
    {
        $ssl = $this->sslDir();
        if (is_file($ssl . '/default.pem') && is_file($ssl . '/default.key')) {
            return $ssl . '/default';
        }
        if ($records !== []) {
            return $records[0]['cert'];
        }
        // No certificate on the box: HTTPS is not served by the cache (nothing to terminate with).
        return null;
    }

    // ---- files ---------------------------------------------------------------

    private function remember(string $path): void
    {
        if (!array_key_exists($path, $this->snap)) {
            $this->snap[$path] = is_file($path) ? (string)file_get_contents($path) : null;
        }
    }

    private function restore(): void
    {
        foreach ($this->snap as $path => $prev) {
            if ($prev === null) {
                @unlink($path);
            } else {
                @file_put_contents($path, $prev);
            }
        }
    }

    private function writeAtomic(string $dst, string $body, int $mode = 0644): void
    {
        $dir = dirname($dst);
        if (!is_dir($dir) && !mkdir($dir, 0755, true) && !is_dir($dir)) {
            throw new IwcacheException("Cannot create $dir");
        }
        $this->remember($dst);
        $tmp = $dst . '.tmp.' . getmypid();
        if (file_put_contents($tmp, $body) === false) {
            throw new IwcacheException("Cannot write $tmp");
        }
        chmod($tmp, $mode);
        if (!rename($tmp, $dst)) {
            @unlink($tmp);
            throw new IwcacheException("Cannot install $dst");
        }
    }

    private function removeFile(string $path): void
    {
        $this->remember($path);
        if (is_file($path)) {
            @unlink($path);
        }
    }

    /** Validate a cache config body with nginx -t before it replaces the live file. */
    private function installCacheConf(string $body): void
    {
        $dst = $this->confDir() . '/webcache.conf';
        $dir = dirname($dst);
        if (!is_dir($dir) && !mkdir($dir, 0755, true) && !is_dir($dir)) {
            throw new IwcacheException("Cannot create $dir");
        }
        $tmp = $dst . '.check.' . getmypid();
        file_put_contents($tmp, $body);
        [$rc, $out, $err] = Proc::run(['nginx', '-t', '-c', $tmp]);
        @unlink($tmp);
        if ($rc !== 0) {
            throw new IwcacheException('nginx -t (cache config) failed: ' . trim($err . ' ' . $out));
        }
        $this->writeAtomic($dst, $body);
        [$rc, $out, $err] = Proc::run(['nginx', '-t', '-c', $dst]);
        if ($rc !== 0) {
            throw new IwcacheException('nginx -t (installed cache config) failed: ' . trim($err . ' ' . $out));
        }
    }

    private function ensureDirs(): void
    {
        foreach ([$this->path('cache-dir', '/var/cache/kloxo-webcache'), $this->path('log-dir', '/var/log/kloxo')] as $d) {
            if (!is_dir($d) && !mkdir($d, 0755, true) && !is_dir($d)) {
                throw new IwcacheException("Cannot create $d");
            }
            if (function_exists('posix_getpwnam') && ($pw = posix_getpwnam('www-data')) !== false
                && posix_geteuid() === 0) {
                @chown($d, (int)$pw['uid']);
                @chgrp($d, (int)$pw['gid']);
            }
        }
    }

    // ---- backend files ------------------------------------------------------

    private function nginxRealIpPath(): string
    {
        return $this->nginxConfD() . '/kloxo-webcache-realip.conf';
    }

    private function apacheRealIpPath(): string
    {
        return $this->apacheDir() . '/conf-available/kloxo-webcache-realip.conf';
    }

    private function apachePorts(): string
    {
        return $this->apacheDir() . '/ports.conf';
    }

    private function apacheInstalled(): bool
    {
        return is_dir($this->apacheDir()) && is_file($this->apachePorts());
    }

    private function backendFront(): void
    {
        if (is_dir($this->nginxConfD())) {
            $this->writeAtomic($this->nginxRealIpPath(), IWCACHE_MARK . "\nset_real_ip_from 127.0.0.1;\nreal_ip_header X-Forwarded-For;\n");
        }
        if ($this->apacheInstalled()) {
            $ports = $this->apachePorts();
            $cur = (string)file_get_contents($ports);
            $orig = $ports . '.kloxo-orig';
            if (!str_contains($cur, IWCACHE_MARK) && !is_file($orig)) {
                $this->remember($orig);
                file_put_contents($orig, $cur);
            }
            $this->writeAtomic($ports, IWCACHE_MARK . "\n"
                . 'Listen 127.0.0.1:' . IWCACHE_BACK_HTTP . "\n"
                . "<IfModule ssl_module>\n\tListen 127.0.0.1:" . IWCACHE_BACK_HTTPS . "\n</IfModule>\n");
            $this->writeAtomic($this->apacheRealIpPath(), IWCACHE_MARK . "\n"
                . "<IfModule remoteip_module>\n\tRemoteIPHeader X-Forwarded-For\n\tRemoteIPInternalProxy 127.0.0.1\n</IfModule>\n");
            if (Proc::exists('a2enmod')) {
                Proc::run(['a2enmod', '-q', 'remoteip']);
            }
            if (Proc::exists('a2enconf')) {
                Proc::run(['a2enconf', '-q', 'kloxo-webcache-realip']);
            }
        }
    }

    private function backendNone(): void
    {
        $this->removeFile($this->nginxRealIpPath());
        if ($this->apacheInstalled()) {
            $ports = $this->apachePorts();
            $orig = $ports . '.kloxo-orig';
            $cur = (string)file_get_contents($ports);
            if (str_contains($cur, IWCACHE_MARK)) {
                $stock = is_file($orig) ? (string)file_get_contents($orig)
                    : "Listen 80\n<IfModule ssl_module>\n\tListen 443\n</IfModule>\n";
                $this->writeAtomic($ports, $stock);
            }
            if (Proc::exists('a2disconf')) {
                Proc::run(['a2disconf', '-q', 'kloxo-webcache-realip']);
            }
            $this->removeFile($this->apacheRealIpPath());
        }
    }

    private function active(string $unit): bool
    {
        [$rc] = Proc::run(['systemctl', 'is-active', '--quiet', $unit]);

        return $rc === 0;
    }

    /** @return list<string> active backend units */
    private function activeBackends(): array
    {
        $u = [];
        foreach (['nginx', 'apache2'] as $unit) {
            if ($this->active($unit)) {
                $u[] = $unit;
            }
        }

        return $u;
    }

    private function validateBackends(): void
    {
        if (is_file('/etc/nginx/nginx.conf') || isset($this->opt['check-backends'])) {
            [$rc, $out, $err] = Proc::run(['nginx', '-t']);
            if ($rc !== 0) {
                throw new IwcacheException('nginx -t (site server) failed: ' . trim($err . ' ' . $out));
            }
        }
        if ($this->apacheInstalled() && Proc::exists('apache2ctl')) {
            [$rc, $out, $err] = Proc::run(['apache2ctl', 'configtest']);
            if ($rc !== 0) {
                throw new IwcacheException('apache2ctl configtest failed: ' . trim($err . ' ' . $out));
            }
        }
    }

    private function reloadBackends(): void
    {
        foreach ($this->activeBackends() as $unit) {
            // Apache needs a full restart to change Listen; nginx re-binds on reload.
            $cmd = $unit === 'apache2' ? 'restart' : 'reload';
            [$rc, $out, $err] = Proc::run(['systemctl', $cmd, $unit]);
            if ($rc !== 0 && $unit === 'nginx') {
                [$rc, $out, $err] = Proc::run(['systemctl', 'restart', $unit]);
            }
            if ($rc !== 0) {
                throw new IwcacheException("systemctl $cmd $unit failed: " . trim($err . ' ' . $out));
            }
        }
    }

    private function health(array $targets): void
    {
        if (isset($this->opt['no-health'])) {
            return;
        }
        if (isset($this->opt['health']) && $this->opt['health'] !== true) {
            $targets = array_values(array_filter(explode(',', (string)$this->opt['health'])));
        }
        foreach ($targets as $t) {
            if (preg_match('/^([0-9.]+):([0-9]{1,5})$/', $t, $m) !== 1) {
                throw new IwcacheException("Invalid health target $t");
            }
            $ok = false;
            for ($i = 0; $i < 10 && !$ok; $i++) {
                $s = @stream_socket_client('tcp://' . $m[1] . ':' . $m[2], $en, $es, 1.0);
                if (is_resource($s)) {
                    fclose($s);
                    $ok = true;
                } else {
                    usleep(300000);
                }
            }
            if (!$ok) {
                throw new IwcacheException("Nothing is listening on $t after the switch");
            }
        }
    }

    private function systemctl(string ...$args): void
    {
        [$rc, $out, $err] = Proc::run(array_merge(['systemctl'], $args));
        if ($rc !== 0) {
            throw new IwcacheException('systemctl ' . implode(' ', $args) . ' failed: ' . trim($err . ' ' . $out));
        }
    }

    // ---- modes -------------------------------------------------------------

    private function front(): int
    {
        if (!Proc::exists('nginx')) {
            throw new IwcacheException('nginx is not installed');
        }
        try {
            $this->ensureDirs();
            $records = $this->records();
            $default = $this->defaultCert($records);
            $this->installCacheConf($this->renderFront($records, $default));
            $this->backendFront();
            $this->writeAtomic($this->flagFile(), "front\n");
            $this->validateBackends();
            $this->reloadBackends();
            $this->systemctl('enable', 'kloxo-webcache');
            $this->systemctl('restart', 'kloxo-webcache');
            $targets = ['127.0.0.1:80'];
            if ($this->activeBackends() !== [] || isset($this->opt['health'])) {
                $targets[] = '127.0.0.1:' . IWCACHE_BACK_HTTP;
            }
            $this->health($targets);
        } catch (IwcacheException $e) {
            $this->restore();
            throw $e;
        }
        echo 'web cache is in front: nginx on 80/443/8080 -> 127.0.0.1:' . IWCACHE_BACK_HTTP . ' and :' . IWCACHE_BACK_HTTPS . "\n";
        echo '  https domains: ' . count($this->records()) . "\n";

        return 0;
    }

    private function none(): int
    {
        if (!Proc::exists('nginx')) {
            throw new IwcacheException('nginx is not installed');
        }
        $side = $this->root . '/file/webfront/webcache.conf';
        $body = is_file($side) ? (string)file_get_contents($side) : '';
        if ($body === '') {
            throw new IwcacheException("missing $side");
        }
        try {
            $this->ensureDirs();
            // The cache holds 80/443 now: stop it so the site server can bind them again.
            Proc::run(['systemctl', 'stop', 'kloxo-webcache']);
            $this->installCacheConf($body);
            $this->backendNone();
            $this->removeFile($this->flagFile());
            $this->validateBackends();
            $this->reloadBackends();
            $this->systemctl('enable', 'kloxo-webcache');
            $this->systemctl('restart', 'kloxo-webcache');
            $this->health(['127.0.0.1:8080']);
        } catch (IwcacheException $e) {
            $this->restore();
            Proc::run(['systemctl', 'start', 'kloxo-webcache']);
            throw $e;
        }
        echo "web cache is beside the site server: nginx on 8080 -> 127.0.0.1:80\n";

        return 0;
    }
}

try {
    exit((new App())->run($argv));
} catch (IwcacheException $e) {
    fwrite(STDERR, 'error: ' . $e->getMessage() . "\n");
    exit(1);
}
