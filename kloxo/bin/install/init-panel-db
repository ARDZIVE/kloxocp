        @chmod($home, 0751);
        if (function_exists('posix_getpwnam') && posix_getpwnam('admin') === false && Proc::exists('useradd')) {
            Proc::run([
                'useradd', '-M', '-d', $home, '-s', '/usr/sbin/nologin',
