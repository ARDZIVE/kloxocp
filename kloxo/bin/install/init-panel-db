    /** @param array<string,string> $props */
    public static function serializeObjectBlob(string $class, array $props): string
    {
        if (preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', $class) !== 1) {
            throw new IpdbException('Invalid serialized class name');
        }
        $body = '';
        foreach ($props as $k => $v) {
            if (preg_match('/^[A-Za-z0-9_]+$/', $k) !== 1) {
                throw new IpdbException('Invalid serialized property name');
            }
            if (str_contains($v, "\0")) {
                throw new IpdbException('Invalid serialized property value');
            }
            $body .= 's:' . strlen($k) . ':"' . $k . '";s:' . strlen($v) . ':"' . $v . '";';
        }

        return base64_encode('O:' . strlen($class) . ':"' . $class . '":' . count($props) . ':{' . $body . '}');
    }

