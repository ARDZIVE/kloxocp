    private function seedDriver(PDO $pdo): void
    {
        $blob = self::driverBlob();
        $n = (int)$pdo->query("SELECT COUNT(*) FROM driver WHERE nname = 'localhost'")->fetchColumn();
        if ($n === 0) {
            $stmt = $pdo->prepare(
                "INSERT INTO driver (nname, parent_clname, parent_cmlist, ser_driver_b)
                 VALUES ('localhost', 'pserver-localhost', '', ?)"
            );
            $stmt->execute([$blob]);
            return;
        }
        $cur = $pdo->query("SELECT ser_driver_b FROM driver WHERE nname = 'localhost'")->fetchColumn();
        $raw = is_string($cur) ? (string)base64_decode($cur, true) : '';
        if ($cur === null || $cur === '' || !str_contains($raw, 'pg_pserver')) {
            $stmt = $pdo->prepare(
                "UPDATE driver SET ser_driver_b = ? WHERE nname = 'localhost'"
            );
            $stmt->execute([$blob]);
            return;
        }
        $migrated = self::migrateServermailDriver($raw);
        $dns = self::migrateDnsDriver($migrated ?? $raw);
        if ($dns !== null) {
            $migrated = $dns;
            // PowerDNS is gone: its Services row goes, the Knot DNS row replaces it.
            try {
                $pdo->exec("DELETE FROM service WHERE nname = 'pdns___localhost'");
                $pdo->exec(
                    ($this->isSqlite($pdo)
                        ? "INSERT OR IGNORE INTO service (nname, parent_clname, parent_cmlist, servicename, description, grepstring, syncserver, oldsyncserver, olddeleteflag)
                     VALUES ('knot___localhost', 'pserver-localhost', '', 'knot', 'Knot DNS Server', 'knotd', 'localhost', '', '')"
                        : "INSERT IGNORE INTO service (nname, parent_clname, parent_cmlist, servicename, description, grepstring, syncserver, oldsyncserver, olddeleteflag)
                     VALUES ('knot___localhost', 'pserver-localhost', '', 'knot', 'Knot DNS Server', 'knotd', 'localhost', '', '')")
                );
            } catch (PDOException $e) {
                // no service table yet: the schema seed already carries the Knot row
            }
        }
        if ($migrated !== null) {
            $stmt = $pdo->prepare("UPDATE driver SET ser_driver_b = ? WHERE nname = 'localhost'");
            $stmt->execute([base64_encode($migrated)]);
        }
    }

    /**
     * PowerDNS was removed (Knot DNS replaces it). An install that had selected it falls back to
     * BIND, which is always installed; Knot is then chosen on Switch Program. Returns the new
     * serialized blob, or null when nothing has to change.
     */
    public static function migrateDnsDriver(string $raw): ?string
    {
        $old = 's:6:"pg_dns";s:4:"pdns";';
        if (!str_contains($raw, $old)) {
            return null;
        }

        return str_replace($old, 's:6:"pg_dns";s:4:"bind";', $raw);
    }

    /**
     * Older installs map Mail Server Settings to the mail driver (pg_mmail). It follows the
     * SMTP choice now, so Exim and Postfix each get their own SMTP protection driver.
     * Returns the new serialized blob, or null when nothing has to change.
     */
    public static function migrateServermailDriver(string $raw): ?string
    {
        $old = 's:13:"pg_servermail";s:9:"__v_mmail";';
        if (!str_contains($raw, $old)) {
            return null;
        }

        return str_replace($old, 's:13:"pg_servermail";s:8:"__v_smtp";', $raw);
    }

    private function md5Crypt(string $pass): string
    {
        $salt = '$1$' . substr(bin2hex(random_bytes(6)), 0, 8) . '$';
        $hash = crypt($pass, $salt);
        if (!is_string($hash) || $hash === '' || $hash === '*0' || $hash === '*1') {
            throw new IpdbException('crypt() failed to hash the admin password');
        }
        if (crypt($pass, $hash) !== $hash) {
            throw new IpdbException('admin password hash did not verify');
        }
        return $hash;
    }

    private function adminPassword(): string
    {
        if (isset($this->opt['admin-password-env']) && $this->opt['admin-password-env'] !== true) {
            $var = (string)$this->opt['admin-password-env'];
            if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', $var)) {
                throw new IpdbException('Invalid --admin-password-env');
            }
            $v = getenv($var);
            if (!is_string($v) || $v === '') {
                throw new IpdbException("Environment variable $var is empty");
            }
            $this->assertAdminPass($v);
            return $v;
        }
        if (isset($this->opt['admin-password']) && $this->opt['admin-password'] !== true) {
            $v = (string)$this->opt['admin-password'];
            $this->assertAdminPass($v);
            return $v;
        }
        return self::DEFAULT_ADMIN_PASS;
    }

    public static function isAllowedAdminPass(string $v): bool
    {
        if ($v === '' || str_contains($v, "\0")) {
            return false;
        }
        if ($v === self::DEFAULT_ADMIN_PASS) {
            return true;
        }
        return strlen($v) >= 8;
    }

    private function assertAdminPass(string $v): void
    {
        if (str_contains($v, "\0")) {
            throw new IpdbException('Admin password contains NUL');
        }
        if (!self::isAllowedAdminPass($v)) {
            throw new IpdbException('Admin password must be at least 8 characters (or the default admin)');
        }
    }

    private function optRoot(): string
    {
        $root = (string)($this->opt['root'] ?? getenv('KLOXO_ROOT') ?: '');
        if ($root === '') {
            $guess = dirname(__DIR__, 2);
            if (is_dir($guess . '/httpdocs') && is_dir($guess . '/file/sql')) {
                $root = $guess;
            }
        }
        $root = rtrim($root, '/');
        if ($root === '' || str_contains($root, "\0") || str_contains($root, '..')) {
            throw new IpdbException('Need --root=DIR (no ..)');
        }
        if (!is_dir($root . '/file/sql')) {
            throw new IpdbException("Not a Kloxo program root: $root");
        }
        $real = realpath($root);
        if ($real === false) {
            throw new IpdbException("Cannot resolve --root: $root");
        }
        return $real;
    }

    private function sqlPath(string $name): string
    {
        if (!preg_match('/^[A-Za-z0-9._-]+$/', $name)) {
            throw new IpdbException('Invalid SQL file name');
        }
        $path = $this->root . '/file/sql/' . $name;
        if ($name !== 'db-structure-update.sql' && !is_file($path)) {
            throw new IpdbException("Missing $path");
        }
        return $path;
    }

    private function ident(string $name, string $label): string
    {
        if (!preg_match('/^[A-Za-z][A-Za-z0-9_]{0,47}$/', $name)) {
            throw new IpdbException("Invalid $label");
        }
        return $name;
    }
