#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * init-panel-db: create the Kloxo CP panel SQLite schema
 * (/var/lib/kloxo/panel.sqlite, or --data-dir / KLOXO_VAR_LIB) so the panel
 * stays up with MariaDB and every other service stopped. MariaDB is still
 * bootstrapped when it is running (customer databases, phpMyAdmin, mail).
 *
 * Copyright (C) 2026 Kloxo CP contributors
 *
 * This program is free software: you can redistribute it and/or modify it
 * under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at
 * your option) any later version. See LICENSE.txt.
 *
 * Standalone: no legacy panel includes. PHP 8.3, PDO, prepared statements,
 * no shell strings. Idempotent: safe to re-run on a half-finished install.
 *
 * Usage:
 *   init-panel-db --root=DIR [--data-dir=DIR] [--admin-password-env=VAR] [--db-socket=PATH]
 *   init-panel-db --print-schema-stats --root=DIR
 *   init-panel-db --help
 */

const IPDB_VERSION = '0.1.0';

final class IpdbException extends RuntimeException
{
}

final class Proc
{
    /** @param list<string> $cmd */
    public static function run(array $cmd, ?string $stdin = null): array
    {
        $p = @proc_open($cmd, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
        if (!is_resource($p)) {
            return [127, '', 'cannot execute ' . ($cmd[0] ?? '')];
        }
        if ($stdin !== null) {
            fwrite($pipes[0], $stdin);
        }
        fclose($pipes[0]);
        $out = stream_get_contents($pipes[1]);
        $err = stream_get_contents($pipes[2]);
        fclose($pipes[1]);
        fclose($pipes[2]);
        return [proc_close($p), (string)$out, (string)$err];
    }

    public static function exists(string $bin): bool
    {
        foreach (explode(':', (string)getenv('PATH') . ':/usr/sbin:/usr/bin:/bin') as $d) {
            if ($d !== '' && is_executable($d . '/' . $bin)) {
                return true;
            }
        }
        return false;
    }
}

final class SqlFile
{
    /** @return list<string> */
    public static function statements(string $sql): array
    {
        $sql = preg_replace('/^\s*--.*$/m', '', $sql) ?? $sql;
        $out = [];
        foreach (explode(';', $sql) as $chunk) {
            $stmt = trim($chunk);
            if ($stmt === '') {
                continue;
            }
            if (preg_match('/^(CREATE\s+DATABASE|USE\s+|SET\s+|\/\*!)/i', $stmt) === 1) {
                continue;
            }
            $out[] = $stmt;
        }
        return $out;
    }

    /** @return list<string> */
    public static function tables(string $sql): array
    {
        $names = [];
        if (preg_match_all('/CREATE\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?`?([A-Za-z0-9_]+)`?/i', $sql, $m) > 0) {
            $names = $m[1];
        }
        sort($names);
        return $names;
    }

    /**
     * MariaDB 10.6+/11.x rejects the legacy dump: client/domain/web have
     * ~100 varchar(255) columns and error 1118 (row size > 8126).
     * Quota flags become varchar(32); other nullable varchar(255) become TEXT
     * (off-page). Indexed nname/parent_clname stay varchar(255).
     */
    public static function innodbSafe(string $stmt): string
    {
        if (preg_match('/^\s*CREATE\s+TABLE/i', $stmt) !== 1) {
            return $stmt;
        }
        $out = preg_replace(
            '/`(priv_q_[A-Za-z0-9_]+|used_q_[A-Za-z0-9_]+)`\s+varchar\(255\)/i',
            '`$1` varchar(32)',
            $stmt
        );
        $stmt = is_string($out) ? $out : $stmt;
        $out = preg_replace_callback(
            '/`([A-Za-z0-9_]+)`\s+varchar\(255\)\s+DEFAULT NULL/i',
            static function (array $m): string {
                $col = strtolower($m[1]);
                if ($col === 'nname' || $col === 'parent_clname') {
                    return $m[0];
                }

                return '`' . $m[1] . '` TEXT DEFAULT NULL';
            },
            $stmt
        );
        $stmt = is_string($out) ? $out : $stmt;
        if (preg_match('/ENGINE\s*=/i', $stmt) !== 1) {
            $out = preg_replace(
                '/\)\s*(DEFAULT CHARSET=)/i',
                ') ENGINE=InnoDB ROW_FORMAT=DYNAMIC $1',
                $stmt,
                1
            );
            $stmt = is_string($out) ? $out : $stmt;
        } elseif (stripos($stmt, 'ROW_FORMAT') === false) {
            $out = preg_replace('/ENGINE\s*=\s*(\w+)/i', 'ENGINE=$1 ROW_FORMAT=DYNAMIC', $stmt, 1);
            $stmt = is_string($out) ? $out : $stmt;
        }

        return $stmt;
    }
}

final class App
{
    public const DEFAULT_ADMIN_USER = 'admin';
    public const DEFAULT_ADMIN_PASS = 'admin';

    /** @var array<string,string|true> */
    private array $opt = [];
    private string $root;
    private string $dbName = 'kloxo';
    private string $dbUser = 'kloxo';
    private string $socket = '';

    public function run(array $argv): int
    {
        array_shift($argv);
        foreach ($argv as $a) {
            if ($a === '--help' || $a === '-h') {
                return $this->help();
            }
            if ($a === '--version') {
                echo 'init-panel-db ' . IPDB_VERSION . "\n";
                return 0;
            }
            if ($a === '--print-schema-stats') {
                $this->opt['print-schema-stats'] = true;
                continue;
            }
            if ($a === '--self-test') {
                $this->opt['self-test'] = true;
                continue;
            }
            if (str_starts_with($a, '--') && str_contains($a, '=')) {
                [$k, $v] = explode('=', substr($a, 2), 2);
                $this->opt[$k] = $v;
                continue;
            }
            if (str_starts_with($a, '--')) {
                $this->opt[substr($a, 2)] = true;
                continue;
            }
            throw new IpdbException("Unknown argument: $a");
        }

        if (isset($this->opt['self-test'])) {
            return $this->selfTest();
        }
        $this->root = $this->optRoot();
        if (isset($this->opt['print-schema-stats'])) {
            return $this->printStats();
        }
        return $this->init();
    }

    private function help(): int
    {
        echo <<<TXT
init-panel-db 0.1.0: create the Kloxo CP panel SQLite schema

  init-panel-db --root=DIR [--admin-password-env=VAR | --keep-admin-password]
                [--db-socket=PATH] [--db-rootuser=root] [--db-name=kloxo] [--db-user=kloxo]
                [--sqlite-only] [--data-dir=DIR]
  init-panel-db --print-schema-stats --root=DIR
  init-panel-db --self-test
  init-panel-db --help

Writes panel.sqlite (0600, lxlabs) from db-structure-base.sql (and -update.sql)
plus storage migrations. Default path is /var/lib/kloxo/panel.sqlite (root on
Linux) or <root>/var/lib/kloxo/panel.sqlite. Override with --data-dir or
KLOXO_VAR_LIB. The panel UI and kloxo-backend use this file; they do not
need MariaDB. --sqlite-only skips MariaDB entirely.

When MariaDB is up, also creates the kloxo / kloxo_pma users (CREATE USER +
GRANT; never GRANT ... IDENTIFIED BY), writes kloxo.pass and pma.pass, and
copies an existing MariaDB panel database into the SQLite file once. phpMyAdmin
uses root@127.0.0.1; root@localhost stays unix_socket. Inserts admin / general
rows if they are missing.

Admin UI password: omitted flags seed the well-known default admin/admin
(must be changed after first login). Override with --admin-password-env=VAR
(preferred) or --admin-password= (visible in ps). Custom passwords must be
at least 8 characters. With --keep-admin-password an existing admin row keeps
its current password (re-runs and updates); a missing admin row is still
created with the password above.

Also seeds the database administrator row (dbadmin, mysql___localhost) with the
kloxo_pma account so Add Database works.

Ubuntu 24.04 / 26.x: creates the kloxo DB user via the mariadb CLI (unix
socket, no root password prompt) then loads the schema as that user. Re-run is safe
on a half-finished install (CREATE TABLE IF NOT EXISTS, INSERT IGNORE).

TXT;
        return 0;
    }

    private function printStats(): int
    {
        $base = $this->sqlPath('db-structure-base.sql');
        $upd = $this->sqlPath('db-structure-update.sql');
        $sql = (string)file_get_contents($base);
        $tables = SqlFile::tables($sql);
        $need = ['client', 'domain', 'general', 'pserver', 'web'];
        $missing = array_values(array_diff($need, $tables));
        $data = [
            'base' => $base,
            'update' => is_file($upd) ? $upd : null,
            'statements' => count(SqlFile::statements($sql)),
            'tables' => count($tables),
            'has_client' => in_array('client', $tables, true),
            'has_general' => in_array('general', $tables, true),
            'has_web' => in_array('web', $tables, true),
            'has_domain' => in_array('domain', $tables, true),
            'has_pserver' => in_array('pserver', $tables, true),
            'missing_required' => $missing,
        ];
        echo json_encode($data, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . "\n";
        return $missing === [] ? 0 : 1;
    }

    private function sqliteLib(): string
    {
        return $this->root . '/httpdocs/lib/php/kloxo_sqlite.php';
    }

    private function sqlitePath(): string
    {
        return $this->dataDir() . '/panel.sqlite';
    }

    /** Panel + stats SQLite directory (never /tmp; local disk under /var/lib or --root). */
    private function dataDir(): string
    {
        if (isset($this->opt['data-dir']) && $this->opt['data-dir'] !== true) {
            $d = rtrim((string) $this->opt['data-dir'], '/');
            if ($d === '' || str_contains($d, "\0") || str_contains($d, '..')) {
                throw new IpdbException('Invalid --data-dir');
            }
            return $d;
        }
        $env = getenv('KLOXO_VAR_LIB');
        if (is_string($env) && $env !== '' && !str_contains($env, "\0") && !str_contains($env, '..')) {
            return rtrim($env, '/');
        }
        if (function_exists('posix_geteuid') && posix_geteuid() === 0 && is_dir('/var/lib')) {
            return '/var/lib/kloxo';
        }

        return $this->root . '/var/lib/kloxo';
    }

    private function storageBootstrap(): string
    {
        $fromRoot = dirname($this->sqliteLib()) . '/storage/bootstrap.php';
        if (is_file($fromRoot)) {
            return $fromRoot;
        }

        return dirname(__DIR__, 2) . '/httpdocs/lib/php/storage/bootstrap.php';
    }

    private function migrationsRoot(): string
    {
        $fromRoot = $this->root . '/file/storage/migrations';
        if (is_dir($fromRoot . '/panel')) {
            return $fromRoot;
        }

        return dirname(__DIR__, 2) . '/file/storage/migrations';
    }

    private function openSqlite(): PDO
    {
        $lib = $this->sqliteLib();
        if (!is_file($lib)) {
            $lib = dirname(__DIR__, 2) . '/httpdocs/lib/php/kloxo_sqlite.php';
        }
        if (!is_file($lib)) {
            throw new IpdbException("Missing $lib");
        }
        require_once $lib;
        $boot = $this->storageBootstrap();
        if (is_file($boot)) {
            require_once $boot;
        }
        putenv('KLOXO_VAR_LIB=' . $this->dataDir());
        if (class_exists('KloxoStore', false)) {
            KloxoStore::resetPool();
        }
        try {
            $pdo = KloxoSqlite::open($this->sqlitePath(), true);
        } catch (PDOException $e) {
            $msg = $e->getMessage();
            if (stripos($msg, 'could not find driver') !== false) {
                $ver = PHP_MAJOR_VERSION . '.' . PHP_MINOR_VERSION;
                throw new IpdbException(
                    "PHP PDO sqlite driver missing for PHP {$ver}. apt-get install php{$ver}-sqlite3"
                    . ' (PHP Branch may have switched /usr/bin/php away from distro PHP)'
                );
            }
            throw new IpdbException($msg);
        }
        KloxoSqlite::secureFile($this->sqlitePath());
        $this->applyStorageMigrations($pdo);

        return $pdo;
    }

    private function applyStorageMigrations(PDO $pdo): void
    {
        if (!class_exists('KloxoMigrate', false)) {
            return;
        }
        $root = $this->migrationsRoot();
        if (is_dir($root . '/panel')) {
            KloxoMigrate::apply($pdo, $root . '/panel');
        }
        if (is_dir($root . '/stats') && class_exists('KloxoStore', false)) {
            KloxoMigrate::apply(KloxoStore::stats(true), $root . '/stats');
        }
    }

    private function applySqliteSchema(PDO $pdo): void
    {
        $base = (string) file_get_contents($this->sqlPath('db-structure-base.sql'));
        foreach (KloxoSqlite::schemaStatements($base) as $stmt) {
            $pdo->exec($stmt);
        }
        $updPath = $this->sqlPath('db-structure-update.sql');
        if (is_file($updPath)) {
            $errors = KloxoSqlite::applyScript($pdo, (string) file_get_contents($updPath));
            foreach ($errors as $err) {
                fwrite(STDERR, "schema warning: $err\n");
            }
        }
    }

    private function isSqlite(PDO $pdo): bool
    {
        return $pdo->getAttribute(PDO::ATTR_DRIVER_NAME) === 'sqlite';
    }

    /** @return list<string> */
    private function columnNames(PDO $pdo, string $table): array
    {
        if ($this->isSqlite($pdo)) {
            return KloxoSqlite::columns($pdo, $table);
        }
        $out = [];
        foreach ($pdo->query('SHOW COLUMNS FROM `' . $table . '`') ?: [] as $row) {
            $out[] = (string) ($row['Field'] ?? '');
        }

        return array_values(array_filter($out, static fn($c) => $c !== ''));
    }

    private function init(): int
    {
        $this->dbName = $this->ident((string)($this->opt['db-name'] ?? 'kloxo'), 'database name');
        $this->dbUser = $this->ident((string)($this->opt['db-user'] ?? 'kloxo'), 'database user');
        $adminPass = $this->adminPassword();
        $rootUser = (string)($this->opt['db-rootuser'] ?? 'root');
        if (!preg_match('/^[A-Za-z0-9_]+$/', $rootUser)) {
            throw new IpdbException('Invalid --db-rootuser');
        }

        $pdo = $this->openSqlite();
        $this->applySqliteSchema($pdo);

        $passFile = $this->root . '/etc/conf/kloxo.pass';
        $pmaFile = $this->root . '/etc/conf/pma.pass';
        $dbPass = $this->dbPassword($passFile);
        $this->writePass($passFile, $dbPass);
        $this->writePass($pmaFile, $this->dbPassword($pmaFile));
        $sqliteOnly = isset($this->opt['sqlite-only']);
        if (!$sqliteOnly) {
            try {
                $mysql = $this->openAdmin($rootUser, $dbPass);
                $mysql->exec('USE `' . $this->dbName . '`');
                $this->maybeCopyFromMysql($mysql, $pdo);
                $this->ensurePmaUser($rootUser);
            } catch (Throwable $e) {
                fwrite(STDERR, "MariaDB skipped (panel SQLite is enough): " . $e->getMessage() . "\n");
            }
        }

        $this->seedAdmin($pdo, $adminPass);
        $this->syncAdminContactEmail($pdo);
        $this->seedAdminHome();
        $this->seedAdminPriv($pdo);
        $this->seedGeneral($pdo);
        $this->seedHelpdesk($pdo);
        $this->seedNotification($pdo);
        $this->seedPserver($pdo);
        $this->seedDbadmin($pdo);
        $this->seedDriver($pdo);
        $this->seedPhpini($pdo);
        $this->seedServerweb($pdo);
        $this->seedServerftp($pdo);
        $this->seedWatchdog($pdo);
        $this->seedSpecialplay($pdo);

        $client = (int)$pdo->query("SELECT COUNT(*) FROM client WHERE nname = 'admin'")->fetchColumn();
        $general = (int)$pdo->query("SELECT COUNT(*) FROM general")->fetchColumn();
        $tables = count(KloxoSqlite::tables($pdo));
        echo "panel db ready: {$this->sqlitePath()} ($tables tables), admin row=$client, general rows=$general\n";
        echo "db password file: $passFile (MariaDB customer SQL / phpMyAdmin)\n";
        return ($client === 1 && $general >= 1 && $tables >= 40) ? 0 : 1;
    }

    private function maybeCopyFromMysql(PDO $mysql, PDO $sqlite): void
    {
        $n = (int) $sqlite->query("SELECT COUNT(*) FROM client WHERE nname = 'admin'")->fetchColumn();
        if ($n > 0) {
            return;
        }
        try {
            $has = (int) $mysql->query("SELECT COUNT(*) FROM client WHERE nname = 'admin'")->fetchColumn();
        } catch (PDOException $e) {
            return;
        }
        if ($has < 1) {
            return;
        }
        $copied = KloxoSqlite::copyFromMysql($mysql, $sqlite);
        echo 'copied MariaDB panel rows into SQLite: ' . array_sum($copied) . "\n";
    }

    /**
     * Unix sockets are not regular files: PHP is_file() is false for them.
     * file_exists() is true. Using is_file() made us skip the socket and fall
     * back to TCP, which Ubuntu rejects for root (SQLSTATE 1698).
     */
    public static function socketExists(string $path): bool
    {
        if ($path === '' || str_contains($path, "\0") || str_contains($path, '..')) {
            return false;
        }
        return file_exists($path);
    }

    /** @return list<string> */
    private function socketCandidates(): array
    {
        $hosts = [];
        if (isset($this->opt['db-socket']) && $this->opt['db-socket'] !== true) {
            $hosts[] = (string)$this->opt['db-socket'];
        }
        $hosts[] = '/run/mysqld/mysqld.sock';
        $hosts[] = '/run/mysqld/mariadb.sock';
        $hosts[] = '/run/mariadb/mysqld.sock';
        $hosts[] = '/var/run/mysqld/mysqld.sock';
        $hosts[] = '/var/lib/mysql/mysql.sock';
        return $hosts;
    }

    private function openAdmin(string $rootUser, string $dbPass): PDO
    {
        $rootPass = (string)($this->opt['db-rootpassword'] ?? '');
        // Ubuntu root is unix_socket. Use the mariadb CLI first so PHP PDO never
        // tries TCP as root (that prints SQLSTATE 1698). No warning on success.
        if ($rootPass === '') {
            try {
                $this->cliBootstrap($rootUser, $dbPass);
                return $this->connectApp($dbPass);
            } catch (IpdbException $e) {
                $pdo = $this->connectRoot($rootUser);
                $pdo->exec('CREATE DATABASE IF NOT EXISTS `' . $this->dbName . '` CHARACTER SET latin1');
                $this->ensureUser($pdo, $dbPass);
                return $pdo;
            }
        }
        $pdo = $this->connectRoot($rootUser);
        $pdo->exec('CREATE DATABASE IF NOT EXISTS `' . $this->dbName . '` CHARACTER SET latin1');
        $this->ensureUser($pdo, $dbPass);
        return $pdo;
    }

    private function connectRoot(string $user): PDO
    {
        $pass = (string)($this->opt['db-rootpassword'] ?? '');
        $last = null;
        foreach ($this->socketCandidates() as $sock) {
            if (!self::socketExists($sock)) {
                continue;
            }
            try {
                $pdo = new PDO(
                    'mysql:unix_socket=' . $sock . ';charset=utf8mb4',
                    $user,
                    $pass,
                    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
                );
                $this->socket = $sock;
                return $pdo;
            } catch (PDOException $e) {
                $last = $e;
            }
        }
        if ($pass !== '') {
            try {
                return new PDO(
                    'mysql:host=127.0.0.1;charset=utf8mb4',
                    $user,
                    $pass,
                    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
                );
            } catch (PDOException $e) {
                $last = $e;
            }
        }
        $msg = $last !== null ? $last->getMessage() : 'no MariaDB socket found';
        throw new IpdbException('Cannot connect to MariaDB as ' . $user . ': ' . $msg);
    }

    private function connectApp(string $dbPass): PDO
    {
        $dsn = $this->socket !== ''
            ? 'mysql:unix_socket=' . $this->socket . ';dbname=' . $this->dbName . ';charset=utf8mb4'
            : 'mysql:unix_socket=/run/mysqld/mysqld.sock;dbname=' . $this->dbName . ';charset=utf8mb4';
        foreach ($this->socketCandidates() as $sock) {
            if (!self::socketExists($sock)) {
                continue;
            }
            try {
                $pdo = new PDO(
                    'mysql:unix_socket=' . $sock . ';dbname=' . $this->dbName . ';charset=utf8mb4',
                    $this->dbUser,
                    $dbPass,
                    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
                );
                $this->socket = $sock;
                return $pdo;
            } catch (PDOException $e) {
                $dsn = $e->getMessage();
            }
        }
        throw new IpdbException('Cannot connect as ' . $this->dbUser . ': ' . $dsn);
    }

    private function cliBootstrap(string $rootUser, string $dbPass): void
    {
        $bin = Proc::exists('mariadb') ? 'mariadb' : (Proc::exists('mysql') ? 'mysql' : '');
        if ($bin === '') {
            throw new IpdbException('MariaDB client (mariadb or mysql) not in PATH; cannot use unix_socket fallback');
        }
        $u = $this->dbUser;
        $db = $this->dbName;
        $q = $this->sqlQuote($dbPass);
        $sql = "CREATE DATABASE IF NOT EXISTS `{$db}` CHARACTER SET latin1;\n"
            . "CREATE USER IF NOT EXISTS '{$u}'@'localhost' IDENTIFIED BY {$q};\n"
            . "ALTER USER '{$u}'@'localhost' IDENTIFIED BY {$q};\n"
            . "GRANT ALL PRIVILEGES ON `{$db}`.* TO '{$u}'@'localhost';\n"
            . "FLUSH PRIVILEGES;\n";
        $cmd = [$bin, '--protocol=socket', '-u', $rootUser];
        foreach ($this->socketCandidates() as $sock) {
            if (self::socketExists($sock)) {
                $cmd[] = '--socket=' . $sock;
                $this->socket = $sock;
                break;
            }
        }
        [$rc, $out, $err] = Proc::run($cmd, $sql);
        if ($rc !== 0) {
            throw new IpdbException("{$bin} unix_socket bootstrap failed: " . trim($err . ' ' . $out));
        }
    }

    private function ensureUser(PDO $pdo, string $dbPass): void
    {
        $u = $this->dbUser;
        $db = $this->dbName;
        $stmt = $pdo->prepare("CREATE USER IF NOT EXISTS '{$u}'@'localhost' IDENTIFIED BY ?");
        $stmt->execute([$dbPass]);
        $stmt = $pdo->prepare("ALTER USER '{$u}'@'localhost' IDENTIFIED BY ?");
        $stmt->execute([$dbPass]);
        $pdo->exec("GRANT ALL PRIVILEGES ON `{$db}`.* TO '{$u}'@'localhost'");
        $pdo->exec('FLUSH PRIVILEGES');
    }

    private function dbPassword(string $passFile): string
    {
        if (is_file($passFile)) {
            $existing = trim((string)file_get_contents($passFile));
            if ($existing !== '') {
                return $existing;
            }
        }
        return bin2hex(random_bytes(16));
    }

    private function sqlQuote(string $s): string
    {
        if (str_contains($s, "\0")) {
            throw new IpdbException('Password contains NUL');
        }
        return "'" . str_replace("'", "''", $s) . "'";
    }

    private function selfTest(): int
    {
        $bad = ['', "/tmp/../etc/passwd", "/no/such/kloxo-mysqld.sock", "foo\0bar"];
        foreach ($bad as $p) {
            if (self::socketExists($p)) {
                fwrite(STDERR, "socketExists should reject [$p]\n");
                return 1;
            }
        }
        if (!self::isAllowedAdminPass(self::DEFAULT_ADMIN_PASS)
            || self::isAllowedAdminPass('short')
            || self::isAllowedAdminPass('')
            || self::isAllowedAdminPass("foo\0bar")
            || !self::isAllowedAdminPass('longenough')) {
            fwrite(STDERR, "admin password policy failed\n");
            return 1;
        }
        $blob = self::phpiniFlagBlob('/var/lib/php/sessions');
        $raw = base64_decode($blob, true);
        if (!is_string($raw) || !str_contains($raw, 'session_save_path_flag') || !str_contains($raw, '/var/lib/php/sessions')
            || !str_contains($raw, 'max_execution_time_flag') || !str_contains($raw, 'allow_url_fopen_flag')) {
            fwrite(STDERR, "phpini blob failed\n");
            return 1;
        }
        $sp = base64_decode(self::specialplayBlob(), true);
        if (!is_string($sp) || !str_contains($sp, 'SpecialPlay_b') || !str_contains($sp, 'simplicity')) {
            fwrite(STDERR, "specialplay blob failed\n");
            return 1;
        }
        $hd = base64_decode(self::helpdeskCategoryBlob(), true);
        if (!is_string($hd) || !str_contains($hd, 'helpdeskcategory_a') || !str_contains($hd, 'Welcome')) {
            fwrite(STDERR, "helpdesk category blob failed\n");
            return 1;
        }
        $sample = "CREATE TABLE IF NOT EXISTS `client` (\n"
            . "  `nname` varchar(255) NOT NULL,\n"
            . "  `parent_clname` varchar(255) DEFAULT NULL,\n"
            . "  `priv_q_domain_num` varchar(255) DEFAULT NULL,\n"
            . "  `used_q_domain_num` varchar(255) DEFAULT NULL,\n"
            . "  `contactemail` varchar(255) DEFAULT NULL,\n"
            . "  PRIMARY KEY (`nname`),\n"
            . "  KEY `parent_clname_client` (`parent_clname`)\n"
            . ") DEFAULT CHARSET=latin1";
        $safe = SqlFile::innodbSafe($sample);
        if (str_contains($safe, '`priv_q_domain_num` varchar(32)')
            && str_contains($safe, '`used_q_domain_num` varchar(32)')
            && str_contains($safe, '`contactemail` TEXT DEFAULT NULL')
            && str_contains($safe, '`nname` varchar(255) NOT NULL')
            && str_contains($safe, '`parent_clname` varchar(255) DEFAULT NULL')
            && str_contains($safe, 'ENGINE=InnoDB ROW_FORMAT=DYNAMIC')) {
            echo "self-test ok\n";
            return 0;
        }
        fwrite(STDERR, "innodbSafe rewrite failed\n");
        return 1;
    }

    private function execSchema(PDO $pdo, string $stmt): void
    {
        $sql = SqlFile::innodbSafe($stmt);
        try {
            $pdo->exec($sql);
        } catch (PDOException $e) {
            $head = preg_replace('/\s+/', ' ', substr($sql, 0, 96)) ?? substr($sql, 0, 96);
            throw new IpdbException('schema failed: ' . $e->getMessage() . ' [' . $head . ']');
        }
    }

    private function ensurePmaUser(string $rootUser): void
    {
        $passFile = $this->root . '/etc/conf/pma.pass';
        $pass = $this->dbPassword($passFile);
        try {
            $pdo = $this->connectRoot($rootUser);
            $this->grantPmaAccounts($pdo, $pass);
        } catch (Throwable $e) {
            $this->cliGrantPma($rootUser, $pass);
        }
        $this->writePass($passFile, $pass);
    }

    private function grantPmaAccounts(PDO $pdo, string $pass): void
    {
        foreach (array(
            array('root', '127.0.0.1'),
            array('kloxo_pma', 'localhost'),
            array('kloxo_pma', '127.0.0.1'),
        ) as $acct) {
            [$u, $h] = $acct;
            $stmt = $pdo->prepare("CREATE USER IF NOT EXISTS '{$u}'@'{$h}' IDENTIFIED BY ?");
            $stmt->execute([$pass]);
            $stmt = $pdo->prepare("ALTER USER '{$u}'@'{$h}' IDENTIFIED BY ?");
            $stmt->execute([$pass]);
            $pdo->exec("GRANT ALL PRIVILEGES ON *.* TO '{$u}'@'{$h}' WITH GRANT OPTION");
        }
        $pdo->exec('FLUSH PRIVILEGES');
    }

    private function cliGrantPma(string $rootUser, string $pass): void
    {
        $bin = Proc::exists('mariadb') ? 'mariadb' : (Proc::exists('mysql') ? 'mysql' : '');
        if ($bin === '') {
            throw new IpdbException('MariaDB client not in PATH; cannot grant phpMyAdmin root');
        }
        $q = $this->sqlQuote($pass);
        $sql = "CREATE USER IF NOT EXISTS 'root'@'127.0.0.1' IDENTIFIED BY {$q};\n"
            . "ALTER USER 'root'@'127.0.0.1' IDENTIFIED BY {$q};\n"
            . "GRANT ALL PRIVILEGES ON *.* TO 'root'@'127.0.0.1' WITH GRANT OPTION;\n"
            . "CREATE USER IF NOT EXISTS 'kloxo_pma'@'localhost' IDENTIFIED BY {$q};\n"
            . "CREATE USER IF NOT EXISTS 'kloxo_pma'@'127.0.0.1' IDENTIFIED BY {$q};\n"
            . "ALTER USER 'kloxo_pma'@'localhost' IDENTIFIED BY {$q};\n"
            . "ALTER USER 'kloxo_pma'@'127.0.0.1' IDENTIFIED BY {$q};\n"
            . "GRANT ALL PRIVILEGES ON *.* TO 'kloxo_pma'@'localhost' WITH GRANT OPTION;\n"
            . "GRANT ALL PRIVILEGES ON *.* TO 'kloxo_pma'@'127.0.0.1' WITH GRANT OPTION;\n"
            . "FLUSH PRIVILEGES;\n";
        $cmd = [$bin, '--protocol=socket', '-u', $rootUser];
        foreach ($this->socketCandidates() as $sock) {
            if (self::socketExists($sock)) {
                $cmd[] = '--socket=' . $sock;
                break;
            }
        }
        [$rc, $out, $err] = Proc::run($cmd, $sql);
        if ($rc !== 0) {
            throw new IpdbException('phpMyAdmin root@127.0.0.1 failed: ' . trim($err . ' ' . $out));
        }
    }

    private function writePass(string $passFile, string $dbPass): void
    {
        $dir = dirname($passFile);
        if (!is_dir($dir) && !mkdir($dir, 0750, true) && !is_dir($dir)) {
            throw new IpdbException("Cannot create $dir");
        }
        if (file_put_contents($passFile, $dbPass . "\n") === false) {
            throw new IpdbException("Cannot write $passFile");
        }
        chmod($dir, 0750);
        chmod($passFile, 0640);
        // PHP-FPM runs as lxlabs (PHP 8.5 refuses pool user=root). 0600 root
        // made getAdminDbPass() return empty → "using password: NO".
        if (function_exists('posix_getpwnam') && posix_getpwnam('lxlabs') !== false) {
            @chown($dir, 'lxlabs');
            @chgrp($dir, 'lxlabs');
            @chown($passFile, 'lxlabs');
            @chgrp($passFile, 'lxlabs');
        }
    }

    private function seedAdmin(PDO $pdo, string $adminPass): void
    {
        $n = (int)$pdo->query("SELECT COUNT(*) FROM client WHERE nname = 'admin'")->fetchColumn();
        $hash = $this->md5Crypt($adminPass);
        if ($n > 0 && isset($this->opt['keep-admin-password'])) {
            // Re-run on an existing install: do not reset a password the
            // owner already changed.
            $pdo->exec(
                "UPDATE client SET cttype = 'admin', cpstatus = 'on', status = 'on',
                 syncserver = IF(syncserver IS NULL OR syncserver = '', 'localhost', syncserver)
                 WHERE nname = 'admin'"
            );
            return;
        }
        if ($n > 0) {
            $stmt = $pdo->prepare(
                "UPDATE client SET password = ?, realpass = ?, cttype = 'admin', cpstatus = 'on', status = 'on',
                 syncserver = IF(syncserver IS NULL OR syncserver = '', 'localhost', syncserver)
                 WHERE nname = 'admin'"
            );
            $stmt->execute([$hash, $adminPass]);
            return;
        }
        $stmt = $pdo->prepare(
            "INSERT INTO client (nname, password, realpass, cttype, cpstatus, status, ddate, parent_clname, parent_cmlist, syncserver)
             VALUES ('admin', ?, ?, 'admin', 'on', 'on', ?, '', '', 'localhost')"
        );
        $stmt->execute([$hash, $adminPass, (string)time()]);
    }

    /**
     * Copy an admin contact email that is already in the database to
     * etc/slavedb/contactemail, the file the kloxo-watchdog service reads (it
     * must not depend on MariaDB). The panel keeps the file current when the
     * admin saves the profile; this covers installs that predate it. Nothing is
     * written while the address is empty or invalid.
     */
    private function syncAdminContactEmail(PDO $pdo): void
    {
        $stmt = $pdo->prepare("SELECT contactemail FROM client WHERE nname = 'admin'");
        $stmt->execute();
        $mail = trim((string)$stmt->fetchColumn());
        if ($mail === '' || filter_var($mail, FILTER_VALIDATE_EMAIL) === false || preg_match('/[\r\n,;<>]/', $mail) === 1) {
            return;
        }
        $dir = $this->root . '/etc/slavedb';
        if (!is_dir($dir) && !@mkdir($dir, 0755, true) && !is_dir($dir)) {
            return;
        }
        // Same format as the panel's slave_save_db(): a serialized Remote with ->data.
        $o = new stdClass();
        $o->data = ['admin' => ['contactemail' => $mail]];
        $blob = str_replace('O:8:"stdClass"', 'O:6:"Remote"', serialize($o));
        $tmp = $dir . '/.contactemail.' . getmypid();
        if (@file_put_contents($tmp, $blob) === false) {
            return;
        }
        @chmod($tmp, 0644);
        if (function_exists('posix_geteuid') && posix_geteuid() === 0 && function_exists('posix_getgrnam') && posix_getgrnam('lxlabs') !== false) {
            @chown($tmp, 'lxlabs');
            @chgrp($tmp, 'lxlabs');
        }
        @rename($tmp, $dir . '/contactemail');
    }

    private function seedAdminHome(): void
    {
        $home = '/home/admin';
        if (function_exists('posix_geteuid') && posix_geteuid() !== 0) {
            return;
        }
        if (!is_dir($home) && !@mkdir($home, 0751, true) && !is_dir($home)) {
            return;
        }
        @chmod($home, 0751);
        if (function_exists('posix_getpwnam') && posix_getpwnam('admin') === false && Proc::exists('useradd')) {
            Proc::run([
                'useradd', '-M', '-d', $home, '-s', '/usr/sbin/nologin',
                '-c', 'Kloxo admin', 'admin',
            ]);
        }
        if (function_exists('posix_getpwnam')) {
            $pw = posix_getpwnam('admin');
            if (is_array($pw) && isset($pw['uid'], $pw['gid'])) {
                @chown($home, (int)$pw['uid']);
                @chgrp($home, (int)$pw['gid']);
            }
        }
        foreach (['kloxoscript', '__processed_stats'] as $sub) {
            $d = $home . '/' . $sub;
            if (!is_dir($d)) {
                @mkdir($d, 0751, true);
            }
        }
    }

