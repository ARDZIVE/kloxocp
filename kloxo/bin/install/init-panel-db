    public static function phpiniFlagBlob(string $sessionPath): string
    {
        $defaults = self::phpiniFlagDefaults($sessionPath);
        $body = '';
        foreach ($defaults as $k => $v) {
            if (preg_match('/^[A-Za-z0-9_]+$/', $k) !== 1) {
                throw new IpdbException('Invalid phpini flag name');
            }
            if (str_contains($v, "\0")) {
                throw new IpdbException('Invalid phpini flag value');
            }
            $body .= 's:' . strlen($k) . ':"' . $k . '";s:' . strlen($v) . ':"' . $v . '";';
        }
        $obj = 'O:13:"phpini_flag_b":' . count($defaults) . ':{' . $body . '}';

        return base64_encode($obj);
    }

