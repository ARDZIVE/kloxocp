#!/bin/bash
# Install customer-site PHP-FPM versions on Ubuntu: 5.6 (5.6.40), 7.4 (7.4.33),
# and the newest phpX.Y-fpm apt can see (the default). The panel FPM (kloxo-php)
# is not touched. Old 5.6 / 7.4 are EOL; they exist only so a site can be
# switched from Webserver Configure.
#
# Copyright (C) 2026 Kloxo CP contributors
# GNU Affero General Public License v3. See LICENSE.txt.
set -euo pipefail

ROOT="${KLOXO_ROOT:-/opt/kloxo}"
FORCE=0
DRY=0
WANTED_OLD=(5.6 7.4)
# Newest first. 8.6 is listed so a later stable is picked without a code change.
LATEST_CANDIDATES=(8.6 8.5 8.4 8.3)
ALLOW_VERS=(8.6 8.5 8.4 8.3 7.4 5.6)
ONLY_VERS=()
EXTS=(cli fpm mysql xml mbstring curl zip gd intl bcmath opcache soap)

usage() {
  cat <<EOF
install-site-php: customer-site PHP-FPM (5.6, 7.4, latest)

  sudo bash install-site-php [--root=DIR] [--force] [--dry-run] [--versions=X.Y,X.Y]

  --root=DIR         program root (default: ${ROOT})
  --versions=X.Y,... only these series (5.6, 7.4, 8.3, 8.4, 8.5, 8.6)
  --force            reinstall even if php-fpm binaries already exist
  --dry-run          print the plan and exit
  --help

Uses Ubuntu distro packages first. If a wanted series is missing, adds
ppa:ondrej/php (Ondřej Surý) when that PPA publishes packages for this Ubuntu
release; otherwise the series is skipped (no broken apt source is left behind).
The result is written to ROOT/log/install-site-php.status. The panel keeps using kloxo-php.
EOF
}

log() { printf '%s\n' "$*"; }

# One line the panel shows on Webserver Configure: epoch|state|message
STATUS_STATE="failed"
STATUS_MSG="stopped before finishing (see install-site-php.log)"
write_status() {
  local f="${ROOT}/log/install-site-php.status"
  mkdir -p "${ROOT}/log" 2>/dev/null || return 0
  printf '%s|%s|%s\n' "$(date +%s)" "$1" "$2" > "$f" 2>/dev/null || true
  chmod 0644 "$f" 2>/dev/null || true
}
finish_status() { write_status "$STATUS_STATE" "$STATUS_MSG"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

have_fpm() {
  local ver="$1"
  [[ -x "/usr/sbin/php-fpm${ver}" ]]
}

apt_has() {
  local pkg="$1"
  apt-cache show "$pkg" >/dev/null 2>&1
}

pick_latest() {
  local v
  for v in "${LATEST_CANDIDATES[@]}"; do
    if apt_has "php${v}-fpm" || have_fpm "$v"; then
      printf '%s' "$v"
      return 0
    fi
  done
  return 1
}

codename() {
  local c=""
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    c="$(. /etc/os-release; printf '%s' "${VERSION_CODENAME:-}")"
  fi
  printf '%s' "$c"
}

# True when ppa:ondrej/php publishes packages for this Ubuntu release
# (a new release often has none for weeks: the PPA answers 404).
ppa_published() {
  local c url
  c="$(codename)"
  [[ "$c" =~ ^[a-z]+$ ]] || return 1
  url="https://ppa.launchpadcontent.net/ondrej/php/ubuntu/dists/${c}/Release"
  curl -fsI --max-time 20 "$url" >/dev/null 2>&1
}

# A leftover ondrej source for a release the PPA does not serve makes every
# later `apt-get update` fail (E: ... does not have a Release file).
drop_dead_ppa() {
  local f
  for f in /etc/apt/sources.list.d/ondrej-*php*.sources /etc/apt/sources.list.d/ondrej-*php*.list; do
    [[ -e "$f" ]] || continue
    log "removing ${f}: ppa:ondrej/php has no packages for Ubuntu $(codename)"
    rm -f -- "$f"
  done
}

apt_update() {
  apt-get update -y || log "warn: apt-get update reported errors"
}

# Needs the PPA only for series the distro does not carry. Returns 1 (and
# leaves apt healthy) when the PPA cannot serve this release.
ensure_sury() {
  local v
  for v in "$@"; do
    apt_has "php${v}-fpm" || break
    v=""
  done
  if [[ -z "${v:-}" ]]; then
    return 0
  fi
  if ! ppa_published; then
    drop_dead_ppa
    apt_update
    log "ppa:ondrej/php has no packages for Ubuntu $(codename); only the PHP versions Ubuntu itself ships can be installed"
    return 1
  fi
  log "adding ppa:ondrej/php for PHP versions the distro does not ship (EOL ones are for customer sites only)"
  apt-get install -y software-properties-common ca-certificates gnupg apt-transport-https curl
  add-apt-repository -y ppa:ondrej/php
  apt_update
}

pkgs_for() {
  local ver="$1" e p
  printf 'php%s-fpm' "$ver"
  for e in "${EXTS[@]}"; do
    p="php${ver}-${e}"
    if apt_has "$p"; then
      printf ' %s' "$p"
    fi
  done
}

wire_include() {
  local ver="$1"
  local conf="/etc/php/${ver}/fpm/php-fpm.conf"
  local pdir="${ROOT}/file/php-fpm"
  local pooldir="/opt/configs/php-fpm/conf/php${ver}/php-fpm.d"
  local sockdir="/opt/configs/php-fpm/sock"
  local line="include=/opt/configs/php-fpm/conf/php${ver}/php-fpm.d/*.conf"
  mkdir -p "$pooldir" "$sockdir"
  chmod 0775 "$sockdir" || true
  if [[ ! -f "${pooldir}/default.conf" ]]; then
    cat > "${pooldir}/default.conf" <<EOF
[php${ver}-default]
listen = /opt/configs/php-fpm/sock/php${ver}-apache.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
user = www-data
group = www-data
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
EOF
  fi
  if [[ -f "$conf" ]] && ! grep -F -q "$line" "$conf"; then
    printf '\n; Kloxo CP site pools\n%s\n' "$line" >> "$conf"
  fi
  if [[ -x "/usr/sbin/php-fpm${ver}" ]]; then
    "/usr/sbin/php-fpm${ver}" -t >/dev/null
  fi
  systemctl enable "php${ver}-fpm" >/dev/null 2>&1 || true
  systemctl restart "php${ver}-fpm" || systemctl start "php${ver}-fpm" || true
}

write_default_flag() {
  local ver="$1"
  local flagdir="${ROOT}/etc/flag"
  mkdir -p "$flagdir"
  rm -f "${flagdir}"/use_php*.flg
  : > "${flagdir}/use_php${ver}.flg"
  : > "${flagdir}/enablemultiplephp.flg"
}

vers_ok() {
  local v a
  for v in "$@"; do
    for a in "${ALLOW_VERS[@]}"; do
      if [[ "$v" == "$a" ]]; then
        continue 2
      fi
    done
    die "unsupported PHP series: $v"
  done
}

for a in "$@"; do
  case "$a" in
    --help|-h) usage; exit 0 ;;
    --force) FORCE=1 ;;
    --dry-run) DRY=1 ;;
    --root=*) ROOT="${a#--root=}" ;;
    --versions=*)
      IFS=',' read -r -a ONLY_VERS <<< "${a#--versions=}"
      vers_ok "${ONLY_VERS[@]}"
      ;;
    *) die "unknown option: $a (try --help)" ;;
  esac
done

if [[ "$ROOT" == *..* || "$ROOT" == *$'\n'* ]]; then
  die "invalid --root"
fi

if [[ "$DRY" -eq 1 ]]; then
  cat <<EOF
plan: install customer-site PHP-FPM
  root     $ROOT
  versions ${ONLY_VERS[*]:-5.6 (5.6.40), 7.4 (7.4.33), plus newest of: ${LATEST_CANDIDATES[*]}}
  repo     distro apt, then ppa:ondrej/php only if it publishes for this Ubuntu release
  default  newest installed phpX.Y-fpm
  panel    kloxo-php is not changed
EOF
  exit 0
fi

[[ "$(id -u)" -eq 0 ]] || die "run as root"
export DEBIAN_FRONTEND=noninteractive

write_status running "installing ${ONLY_VERS[*]:-site PHP}"
trap finish_status EXIT

# Heal a leftover ondrej source from an earlier run on a release the PPA does not serve.
if compgen -G "/etc/apt/sources.list.d/ondrej-*php*" >/dev/null && ! ppa_published; then
  drop_dead_ppa
fi
apt_update
# Series that must come from the PPA when the distro lacks them.
if [[ ${#ONLY_VERS[@]} -gt 0 ]]; then
  ensure_sury "${ONLY_VERS[@]}" || true
else
  ensure_sury "${WANTED_OLD[@]}" || true
fi

install_one() {
  local ver="$1"
  if have_fpm "$ver" && [[ "$FORCE" -eq 0 ]]; then
    log "php${ver}-fpm already present"
    return 0
  fi
  # shellcheck disable=SC2046
  apt-get install -y $(pkgs_for "$ver")
}

if [[ ${#ONLY_VERS[@]} -gt 0 ]]; then
  done_list=()
  skipped=()
  for v in "${ONLY_VERS[@]}"; do
    if ! apt_has "php${v}-fpm" && ! have_fpm "$v"; then
      log "warn: php${v}-fpm is not available for Ubuntu $(codename); skip"
      skipped+=("$v")
      continue
    fi
    if install_one "$v" && have_fpm "$v"; then
      wire_include "$v" || log "warn: php${v}-fpm could not be wired into the panel pools"
      done_list+=("$v")
    else
      log "warn: php${v}-fpm install failed"
      skipped+=("$v")
    fi
  done
  if [[ ${#done_list[@]} -gt 0 && ${#skipped[@]} -eq 0 ]]; then
    STATUS_STATE="ok"; STATUS_MSG="installed ${done_list[*]}"
    log "installed requested site PHP: ${done_list[*]}"
    exit 0
  elif [[ ${#done_list[@]} -gt 0 ]]; then
    STATUS_STATE="partial"; STATUS_MSG="installed ${done_list[*]}; not available or failed: ${skipped[*]}"
    log "$STATUS_MSG"
    exit 0
  fi
  STATUS_STATE="failed"
  STATUS_MSG="${skipped[*]} not installed: not in Ubuntu $(codename) and ppa:ondrej/php has no packages for it"
  log "$STATUS_MSG"
  exit 1
fi

latest=""
if latest="$(pick_latest)"; then
  log "latest site PHP is ${latest}"
else
  STATUS_MSG="no phpX.Y-fpm package found (tried ${LATEST_CANDIDATES[*]})"
  die "$STATUS_MSG"
fi

install_one "$latest"
skipped=()
for v in "${WANTED_OLD[@]}"; do
  if apt_has "php${v}-fpm"; then
    install_one "$v" || { log "warn: php${v}-fpm install failed (EOL packages)"; skipped+=("$v"); }
  else
    log "warn: php${v}-fpm is not in apt for Ubuntu $(codename); skip"
    skipped+=("$v")
  fi
done

for v in "$latest" "${WANTED_OLD[@]}"; do
  if have_fpm "$v"; then
    wire_include "$v"
  fi
done

write_default_flag "$latest"
log "site PHP default is php${latest} (Webserver Configure can select the others that are installed)"
STATUS_STATE="ok"
STATUS_MSG="php${latest} installed"
if [[ ${#skipped[@]} -gt 0 ]]; then
  STATUS_STATE="partial"
  STATUS_MSG="php${latest} installed; not available for Ubuntu $(codename): ${skipped[*]}"
fi
