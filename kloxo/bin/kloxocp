    'rspamd' => 'Mail filtering (via kloxo-mail)',
];

final class KcpException extends RuntimeException
{
}

final class Proc
{
    /** @param list<string> $cmd */
    public static function run(array $cmd, ?string $stdin = null): array
    {
        $p = @proc_open($cmd, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
        if (!is_resource($p)) {
            return [127, '', 'cannot execute ' . $cmd[0]];
        }
        if ($stdin !== null) {
            fwrite($pipes[0], $stdin);
        }
        fclose($pipes[0]);
        $out = stream_get_contents($pipes[1]);
        $err = stream_get_contents($pipes[2]);
        fclose($pipes[1]);
        fclose($pipes[2]);
        return [proc_close($p), (string)$out, (string)$err];
    }

    public static function exists(string $bin): bool
    {
        foreach (explode(':', (string)getenv('PATH') . ':/usr/sbin:/sbin:/opt/homebrew/bin') as $d) {
            if ($d !== '' && is_executable("$d/$bin")) {
                return true;
            }
        }
        return false;
    }
}

final class Fs
{
    public static function realDir(string $path, string $label): string
    {
        $path = rtrim($path, '/');
        if ($path === '' || str_contains($path, "\0")) {
            throw new KcpException("Invalid $label");
        }
        if (!is_dir($path) && !mkdir($path, 0750, true) && !is_dir($path)) {
            throw new KcpException("Cannot create $label: $path");
        }
        $real = realpath($path);
        if ($real === false) {
            throw new KcpException("Cannot resolve $label: $path");
        }
        return $real;
    }

    public static function copyPath(string $src, string $dst): void
    {
        if (is_link($src) || is_file($src)) {
            $dir = dirname($dst);
            if (!is_dir($dir) && !mkdir($dir, 0750, true) && !is_dir($dir)) {
                throw new KcpException("Cannot create $dir");
            }
            // PHP copy() fails when source and destination are the same inode
            // (/opt/kloxo → clone/kloxo, then upcp copies kloxoversion onto itself).
            $srcReal = realpath($src);
            if ($srcReal !== false && is_file($dst)) {
                $dstReal = realpath($dst);
                if ($dstReal !== false && $srcReal === $dstReal) {
                    return;
                }
            }
            if (!copy($src, $dst)) {
                throw new KcpException("Copy failed: $src");
            }
            $mode = fileperms($src);
            if ($mode !== false) {
                chmod($dst, $mode & 0777);
            }
            return;
        }
        if (!is_dir($src)) {
            return;
        }
        if (!is_dir($dst) && !mkdir($dst, 0750, true) && !is_dir($dst)) {
            throw new KcpException("Cannot create $dst");
        }
        $it = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST
        );
        foreach ($it as $f) {
            $rel = substr($f->getPathname(), strlen($src) + 1);
            if ($rel === false || $rel === '') {
                continue;
            }
            // Only refuse a path *segment* of ".." (traversal). Names like
            // icon/collage/subweb_a_addform..gif are real Kloxo-MR assets.
            foreach (explode('/', str_replace('\\', '/', $rel)) as $seg) {
                if ($seg === '..') {
                    throw new KcpException("Refusing path with .. : $rel");
                }
            }
            $target = $dst . '/' . $rel;
            if ($f->isDir() && !$f->isLink()) {
                if (!is_dir($target) && !mkdir($target, 0750, true) && !is_dir($target)) {
                    throw new KcpException("Cannot create $target");
                }
                continue;
            }
            self::copyPath($f->getPathname(), $target);
        }
    }

    public static function rmTree(string $path): void
    {
        if (is_file($path) || is_link($path)) {
            unlink($path);
            return;
        }
        $real = realpath($path);
        if ($real === false) {
            return;
        }
        $it = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($real, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST
        );
        foreach ($it as $f) {
            $f->isDir() && !$f->isLink() ? rmdir($f->getPathname()) : unlink($f->getPathname());
        }
        rmdir($real);
    }
}

final class App
{
    /** @var array<string,string|true> */
    private array $opt = [];
    private bool $json = false;
    private string $root;
    private string $snapDir;

    public function run(array $argv): int
    {
        array_shift($argv);
        $cmd = 'help';
        $rest = [];
        foreach ($argv as $a) {
            if ($a === '--json') {
                $this->json = true;
                continue;
            }
            if (str_starts_with($a, '--')) {
                [$k, $v] = array_pad(explode('=', substr($a, 2), 2), 2, true);
                if ($k === '' || !preg_match('/^[a-z0-9-]+$/', $k)) {
                    fwrite(STDERR, "error: bad option: $a\n");
                    return 64;
                }
                $this->opt[$k] = $v;
                continue;
            }
            if ($cmd === 'help' && $rest === []) {
                $cmd = $a;
            } else {
                $rest[] = $a;
            }
        }

        try {
            $this->root = $this->resolveRoot();
            $this->snapDir = $this->resolveSnapDir();
            return match ($cmd) {
                'help', '--help', '-h' => $this->help(),
                'version', '--version' => $this->say(['version' => KCP_VERSION], 'kloxocp ' . KCP_VERSION),
                'status' => $this->status(),
                'doctor' => $this->doctor(),
                'snapshot' => $this->snapshot(),
                'rollback' => $this->rollback(),
                'update', 'upcp' => $this->update(),
                'install' => $this->install(),
                'component' => $this->component($rest),
                'recovery-password' => $this->recoveryPassword(),
                'test-mail' => $this->testMail(),
                default => $this->unknown($cmd),
            };
        } catch (KcpException $e) {
            fwrite(STDERR, 'error: ' . $e->getMessage() . "\n");
            return 1;
        }
    }

    private function resolveRoot(): string
    {
        $opt = $this->opt['root'] ?? getenv('KLOXO_ROOT');
        if (is_string($opt) && $opt !== '') {
            $r = rtrim($opt, '/');
            if (str_contains($r, "\0") || str_contains($r, '..')) {
                throw new KcpException('Invalid --root');
            }
            return $r;
        }
        if (is_dir('/opt/kloxo/httpdocs')) {
            return '/opt/kloxo';
        }
        return dirname(__DIR__);
    }

    private function resolveSnapDir(): string
    {
        $opt = $this->opt['snap-dir'] ?? '';
        if (is_string($opt) && $opt !== true && $opt !== '') {
            if (str_contains($opt, "\0") || str_contains($opt, '..')) {
                throw new KcpException('Invalid --snap-dir');
            }
            return rtrim($opt, '/');
        }
        return $this->root . '/var/backups/kloxocp';
    }

    private function help(): int
    {
        $v = KCP_VERSION;
        echo <<<TXT
kloxocp — Kloxo CP operator CLI ($v)

  kloxocp help
  kloxocp version
  kloxocp status [--root=DIR] [--json]
  kloxocp doctor [--root=DIR] [--json] [--install]
  kloxocp snapshot [--root=DIR] [--snap-dir=DIR] [--keep=N] [--json]
  kloxocp rollback [--root=DIR] [--snap-dir=DIR] [--stamp=UTC] [--json]
  kloxocp update|upcp [--root=DIR] [--src=DIR] [--branch=NAME] [--check] [--yes]
                      [--no-fetch] [--no-rollback] [--keep=N] [--json]
  kloxocp component list
  kloxocp recovery-password --generate | --password-env=VAR [--if-missing] [--raw] [--root=DIR]
  kloxocp test-mail --to=ADDR [--root=DIR]   queue a panel welcome-style test via sendmail
  kloxocp install           (pre-flight; Ubuntu bootstrap is install.sh)

  update / upcp   cPanel-style panel update (run as root: sudo kloxocp upcp):
                  pre-flight → snapshot → apply → health check; on failure
                  restores the snapshot automatically.
  --check         show the plan only (no snapshot, no apply)
  --src=DIR       source tree with kloxo/ (default: /usr/local/src/kloxo-cp)
  --branch=NAME   git branch to fetch (default: main; ignored with --no-fetch)
  --no-fetch      do not git-fetch; sync from the existing --src tree
  --no-rollback   leave a failed update in place (default: auto-rollback)
  --yes           non-interactive (assumed when stdin is not a TTY)
  --root=DIR      program root (default: /opt/kloxo if present, else this tree)
  --snap-dir=DIR  snapshot directory (default: <root>/var/backups/kloxocp)
  --json          machine-readable output
  --install       doctor in installer mode (extra host checks)
  recovery-password sets the login of https://<server>:7777/recovery/, the console that
                  still starts/stops MariaDB, Nginx, ... when the panel cannot load.

Exit 0 ok, 1 failed check, 2 not implemented, 64 usage.

TXT;
        return 0;
    }

    /**
     * Queue a test message the same way Add Client welcome mail does
     * (lx_mail → sendmail -odq). Run as root on the live server.
     */
    private function testMail(): int
    {
        $to = $this->opt['to'] ?? '';
        if (!is_string($to) || $to === '' || $to === true) {
            throw new KcpException('usage: kloxocp test-mail --to=you@example.com');
        }
        $to = trim($to);
        if (!preg_match('/^[^@\s]+@[^@\s]+\.[^@\s]+$/', $to)) {
            throw new KcpException('invalid --to address');
        }
        $domain = strtolower((string) substr(strrchr($to, '@') ?: '', 1));
        // Docs use you@example.com — that domain will never accept real mail.
        foreach (['example.com', 'example.net', 'example.org', 'invalid', 'localhost', 'test'] as $bad) {
            if ($domain === $bad || str_ends_with($domain, '.' . $bad)) {
                throw new KcpException(
                    '--to uses a documentation/placeholder domain (' . $domain
                    . '); give a real inbox you can open, e.g. --to=you@yourdomain.com'
                );
            }
        }

        $sendmail = '';
        foreach (['/usr/sbin/sendmail', '/usr/lib/sendmail'] as $bin) {
            if (is_executable($bin)) {
                $sendmail = $bin;
                break;
            }
        }
        if ($sendmail === '') {
            throw new KcpException('sendmail not found (apt-get install exim4-daemon-light)');
        }

        // Minimal bootstrap so lx_mail is available without the full panel UI.
        $lib = $this->root . '/httpdocs/lib/html/lib.php';
        $lxlib = $this->root . '/httpdocs/lib/php/lxlib.php';
        if (!is_file($lib)) {
            throw new KcpException('panel lib missing: ' . $lib);
        }
        // lx_mail lives in lib.php but needs a few helpers; include carefully.
        if (!defined('KLOXO_TEST_MAIL_BOOT')) {
            define('KLOXO_TEST_MAIL_BOOT', 1);
        }
        // Prefer the real include chain when possible.
        $inc = $this->root . '/httpdocs/lib/html/include.php';
        if (is_file($inc)) {
            $cwd = getcwd();
            @chdir($this->root . '/httpdocs');
            require_once $inc;
            if (is_string($cwd) && $cwd !== '') {
                @chdir($cwd);
            }
        } else {
            require_once $lxlib;
            require_once $lib;
        }
        if (!function_exists('lx_mail')) {
            throw new KcpException('lx_mail() not loaded');
        }

        $subject = 'Kloxo CP panel test mail';
        $body = "This is a test from kloxocp test-mail on " . gethostname()
            . ".\nIf you received this, panel welcome mail can queue through sendmail.\n";
        $from = function_exists('kloxo_mail_default_from') ? kloxo_mail_default_from() : ('admin@' . gethostname());
        $ok = lx_mail($from, $to, $subject, $body);
        $rep = [
            'to' => $to,
            'from' => $from,
            'sendmail' => $sendmail,
            'queued' => $ok,
            'hint' => $ok
                ? 'queued; mailq; if *** frozen *** see: exim4 -Mvh <id>; thaw: exim4 -M <id> or exim4 -qff; re-apply Exim (trusted_users): php ' . $this->root . '/bin/mail/kloxo-mail apply'
                : 'not queued; see ' . $this->root . '/log/mail_send and systemctl status exim4',
        ];
        if (!$ok) {
            $this->say($rep, 'test-mail FAILED for ' . $to . ' — ' . $rep['hint']);

            return 1;
        }

        return $this->say($rep, 'test-mail queued for ' . $to . ' from ' . $from);
    }

    private function recoveryPassword(): int
    {
        $lib = $this->root . '/httpdocs/lib/php/kloxo_recovery.php';
        if (!is_file($lib)) {
            throw new KcpException('recovery library missing: ' . $lib);
        }
        require_once $lib;
        $path = KloxoRecovery::credentialPath($this->root);
        if (!empty($this->opt['if-missing']) && KloxoRecovery::hasCredential($path)) {
            return $this->say(['changed' => false], 'recovery password already set (unchanged)');
        }
        $generated = false;
        if (!empty($this->opt['generate'])) {
            $pw = KloxoRecovery::generatePassword();
            $generated = true;
        } elseif (isset($this->opt['password-env']) && is_string($this->opt['password-env'])) {
            $var = $this->opt['password-env'];
            if (!preg_match('/^[A-Z_][A-Z0-9_]*$/', $var)) {
                throw new KcpException('bad --password-env name');
            }
            $pw = (string)getenv($var);
        } else {
            fwrite(STDERR, "error: give --generate or --password-env=VAR\n");
            return 64;
        }
        if (strlen($pw) < 12) {
            throw new KcpException('recovery password must be at least 12 characters');
        }
        try {
            KloxoRecovery::writeCredential($pw, $path);
        } catch (Throwable $e) {
            throw new KcpException('cannot write ' . $path . ': ' . $e->getMessage());
        }
        if ($generated && !empty($this->opt['raw'])) {
            echo $pw, "\n";
            return 0;
        }
        if ($generated) {
            return $this->say(['changed' => true, 'password' => $pw], 'recovery password: ' . $pw);
        }
        return $this->say(['changed' => true], 'recovery password updated');
    }

    private function unknown(string $cmd): int
    {
        fwrite(STDERR, "error: unknown command: $cmd (try kloxocp help)\n");
        return 64;
    }

    private function notImplemented(string $what): int
    {
        $msg = "$what is not implemented yet (see docs/INSTALL_AND_UPDATE_DESIGN.md)";
        $this->say(['implemented' => false, 'command' => $what], $msg);
        return 2;
    }

    private function status(): int
    {
        $php = PHP_VERSION;
        $verfile = $this->root . '/bin/kloxoversion';
        $ver = is_file($verfile) ? trim((string)file_get_contents($verfile)) : '';
        $tlsKey = $this->root . '/init/backend.key';
        $tlsPem = $this->root . '/file/ssl/default.pem';
        $services = [];
        foreach (['kloxo-php', 'kloxo-web', 'kloxo-wrap', 'nginx', 'mariadb', 'named'] as $svc) {
            $services[$svc] = $this->serviceState($svc);
        }
        $rep = [
            'root' => $this->root,
            'kloxocp' => KCP_VERSION,
            'kloxoversion' => $ver,
            'php' => $php,
            'php_sapi' => PHP_SAPI,
            'tls' => [
                'backend_key' => is_file($tlsKey),
                'default_pem' => is_file($tlsPem),
            ],
            'login' => is_file($this->root . '/httpdocs/login/index.php'),
            'services' => $services,
        ];
        $txt = "root={$this->root}\n"
            . "kloxocp=" . KCP_VERSION . " kloxoversion=" . ($ver !== '' ? $ver : '(missing)') . "\n"
            . "php={$php}\n"
            . 'tls backend_key=' . ($rep['tls']['backend_key'] ? 'yes' : 'no')
            . ' default_pem=' . ($rep['tls']['default_pem'] ? 'yes' : 'no') . "\n"
            . 'login=' . ($rep['login'] ? 'yes' : 'no') . "\n";
        foreach ($services as $n => $s) {
            $txt .= "service {$n}={$s}\n";
        }
        return $this->say($rep, rtrim($txt));
    }

    private function serviceState(string $name): string
    {
        if (!Proc::exists('systemctl')) {
            return 'unknown';
        }
        [$rc, $out] = Proc::run(['systemctl', 'is-active', $name]);
        $st = trim($out);
        return $st !== '' ? $st : ($rc === 0 ? 'active' : 'inactive');
    }

    private function doctor(): int
    {
        $install = isset($this->opt['install']);
        $checks = [];
        $fail = 0;

        $phpOk = version_compare(PHP_VERSION, '8.3.0', '>=');
        $checks[] = $this->check(
            'php_version',
            $phpOk ? 'pass' : (version_compare(PHP_VERSION, '8.0.0', '>=') ? 'warn' : 'fail'),
            'PHP ' . PHP_VERSION . ($phpOk ? '' : ' (need 8.3+)')
        );

        $layout = is_dir($this->root . '/httpdocs') && is_dir($this->root . '/bin') && is_dir($this->root . '/init');
        $checks[] = $this->check('program_layout', $layout ? 'pass' : 'fail', $layout ? $this->root : "missing httpdocs/bin/init under {$this->root}");

        $verfile = $this->root . '/bin/kloxoversion';
        $checks[] = $this->check('kloxoversion', is_file($verfile) ? 'pass' : 'warn', is_file($verfile) ? trim((string)file_get_contents($verfile)) : 'missing');

        $login = is_file($this->root . '/httpdocs/login/index.php');
        $checks[] = $this->check('login_page', $login ? 'pass' : 'fail', $login ? 'httpdocs/login/index.php' : 'login page not shipped');

        $cli = is_file($this->root . '/init/php-cli.sh') && is_readable($this->root . '/init/php-cli.sh');
        $checks[] = $this->check('php_cli_wrapper', $cli ? 'pass' : 'warn', $cli ? 'init/php-cli.sh' : 'init/php-cli.sh missing');

        $pinFile = $this->root . '/etc/path/php';
        $pin = is_file($pinFile) ? trim((string) file_get_contents($pinFile)) : '';
        $pinOk = $pin !== '' && is_executable($pin);
        $checks[] = $this->check(
            'panel_php_pin',
            $pinOk ? 'pass' : 'warn',
            $pinOk ? $pin : 'missing etc/path/php (install or kloxo-backend.sh will create it)'
        );

        $thisPhp = PHP_BINARY !== '' ? PHP_BINARY : 'php';
        $thisSqlite = extension_loaded('pdo_sqlite');
        $pinSqlite = $pinOk ? $this->phpHasExt($pin, 'pdo_sqlite') : false;
        $aptHint = $this->sqliteAptHint($pinOk ? $pin : $thisPhp);
        if ($pinOk && $pinSqlite) {
            $checks[] = $this->check(
                'pdo_sqlite',
                'pass',
                'pdo_sqlite on pin ' . $pin
                    . ($thisSqlite ? '' : ' (this CLI was ' . PHP_VERSION . ' without sqlite; re-exec uses pin)')
            );
        } elseif ($thisSqlite) {
            $checks[] = $this->check('pdo_sqlite', 'pass', 'pdo_sqlite loaded in ' . PHP_VERSION);
        } else {
            $checks[] = $this->check(
                'pdo_sqlite',
                'fail',
                'missing — ' . $aptHint . '; then: systemctl restart kloxo-backend kloxo-php'
            );
        }

        $key = $this->root . '/init/backend.key';
        if (!is_file($key)) {
            $checks[] = $this->check('tls_backend_key', 'warn', 'missing (run generate-tls-keys)');
        } else {
            $world = (fileperms($key) & 0004) !== 0;
            $checks[] = $this->check('tls_backend_key', $world ? 'fail' : 'pass', $world ? 'world-readable (must be 0600)' : 'present, not world-readable');
        }
        $pem = $this->root . '/file/ssl/default.pem';
        $checks[] = $this->check('tls_default_pem', is_file($pem) ? 'pass' : 'warn', is_file($pem) ? 'present' : 'missing (run generate-tls-keys)');

        $hia = $this->root . '/init/kloxo-hiawatha';
        $checks[] = $this->check(
            'hiawatha_binary',
            is_executable($hia) || Proc::exists('hiawatha') ? 'pass' : 'warn',
            is_executable($hia) ? 'init/kloxo-hiawatha' : (Proc::exists('hiawatha') ? 'hiawatha in PATH' : 'missing (run install-hiawatha)')
        );
        $passfile = $this->root . '/etc/conf/kloxo.pass';
        $checks[] = $this->check(
            'panel_db_pass',
            is_file($passfile) ? 'pass' : 'warn',
            is_file($passfile) ? 'etc/conf/kloxo.pass' : 'missing (run init-panel-db)'
        );

        $mariadbLib = $this->root . '/httpdocs/lib/php/kloxo_mariadb.php';
        if (is_file($mariadbLib)) {
            require_once $mariadbLib;
            if (class_exists('KloxoMariadb', false) && method_exists('KloxoMariadb', 'diagnose')) {
                $md = KloxoMariadb::diagnose($this->root);
                if ($md['ok']) {
                    $checks[] = $this->check('mariadb_connect', 'pass', 'connectAdmin ok in ' . $md['ms'] . 'ms');
                } elseif (!$md['reachable']) {
                    $checks[] = $this->check('mariadb_connect', 'warn', 'MariaDB not listening (' . $md['ms'] . 'ms)');
                } else {
                    $checks[] = $this->check(
                        'mariadb_connect',
                        'warn',
                        substr($md['error'] !== '' ? $md['error'] : 'connectAdmin failed', 0, 120) . ' (' . $md['ms'] . 'ms)'
                    );
                }
            }
        }

        $sqliteLib = $this->root . '/httpdocs/lib/php/kloxo_sqlite.php';
        if (is_file($sqliteLib)) {
            require_once $sqliteLib;
            $varLib = $this->root . '/var/lib/kloxo';
            $panelDb = is_file('/var/lib/kloxo/panel.sqlite')
                ? '/var/lib/kloxo/panel.sqlite'
                : ($varLib . '/panel.sqlite');
            if (getenv('KLOXO_VAR_LIB') === false && is_dir($varLib)) {
                putenv('KLOXO_VAR_LIB=' . $varLib);
            }
            if (class_exists('KloxoSqlite', false) && method_exists('KloxoSqlite', 'diagnose')) {
                $sd = KloxoSqlite::diagnose(is_file($panelDb) ? $panelDb : null);
                if ($sd['ok']) {
                    $checks[] = $this->check(
                        'sqlite_connect',
                        'pass',
                        'panel.sqlite ok (' . $sd['tables'] . ' tables, ' . $sd['journal'] . ', ' . $sd['ms'] . 'ms)'
                    );
                } else {
                    $checks[] = $this->check(
                        'sqlite_connect',
                        extension_loaded('pdo_sqlite') ? 'warn' : 'fail',
                        substr($sd['error'] !== '' ? $sd['error'] : 'open failed', 0, 120) . ' (' . $sd['ms'] . 'ms)'
                    );
                }
            }
        }

        $os = $this->osId();
        $ubuntu = self::ubuntuSupported($os['id'], $os['version']);
        $checks[] = $this->check(
            'os_ubuntu',
            $ubuntu ? 'pass' : ($install ? 'fail' : 'warn'),
            $os['pretty'] !== '' ? $os['pretty'] : 'os-release not found (need Ubuntu 24.04 or 26.x)'
        );

        foreach (['php' => true, 'openssl' => true, 'nginx' => false, 'mariadbd' => false, 'named' => false] as $bin => $req) {
            $ex = Proc::exists($bin) || ($bin === 'mariadbd' && (Proc::exists('mysqld') || Proc::exists('mariadb')));
            $checks[] = $this->check(
                'bin_' . $bin,
                $ex ? 'pass' : ($req ? 'fail' : 'warn'),
                $ex ? 'found' : 'not in PATH'
            );
        }

        if ($install) {
            $uid = function_exists('posix_geteuid') ? posix_geteuid() : -1;
            $checks[] = $this->check('root', $uid === 0 ? 'pass' : 'fail', $uid === 0 ? 'euid 0' : 'installer must run as root');
            foreach ([
                '/usr/local/cpanel' => 'cPanel',
                '/usr/local/psa' => 'Plesk',
                '/usr/local/ispconfig' => 'ISPConfig',
            ] as $path => $name) {
                $hit = is_dir($path);
                $checks[] = $this->check('conflict_' . strtolower($name), $hit ? 'fail' : 'pass', $hit ? "$name detected at $path" : "no $name");
            }
        }

        foreach ($checks as $c) {
            if ($c['result'] === 'fail') {
                $fail++;
            }
        }
        $ok = $fail === 0;
        $txt = '';
        foreach ($checks as $c) {
            $txt .= sprintf("%-4s %-18s %s\n", strtoupper($c['result']), $c['id'], $c['message']);
        }
        $txt .= $ok ? "doctor: ok ($fail fail)\n" : "doctor: FAILED ($fail fail)\n";
        $this->say(['ok' => $ok, 'root' => $this->root, 'checks' => $checks], rtrim($txt));
        return $ok ? 0 : 1;
    }

    /** @return array{id:string,result:string,message:string} */
    private function check(string $id, string $result, string $message): array
    {
        return ['id' => $id, 'result' => $result, 'message' => $message];
    }

    /** True when $bin loads the named extension (subprocess; never hangs long). */
    private function phpHasExt(string $bin, string $ext): bool
    {
        if ($bin === '' || !is_executable($bin) || !preg_match('/^[A-Za-z0-9_]+$/', $ext)) {
            return false;
        }
        $self = realpath((string) (PHP_BINARY ?: '')) ?: '';
        $real = realpath($bin) ?: $bin;
        if ($self !== '' && $real === $self) {
            return extension_loaded($ext);
        }
        $p = @proc_open(
            array($bin, '-r', 'exit(extension_loaded(' . var_export($ext, true) . ') ? 0 : 1);'),
            array(0 => array('file', '/dev/null', 'r'), 1 => array('file', '/dev/null', 'w'), 2 => array('file', '/dev/null', 'w')),
            $pipes
        );
        if (!is_resource($p)) {
            return false;
        }

        return proc_close($p) === 0;
    }

    /** apt package name(s) for pdo_sqlite for this PHP binary. */
    private function sqliteAptHint(string $bin): string
    {
        $ver = '';
        if (is_executable($bin)) {
            $p = @proc_open(
                array($bin, '-r', 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;'),
                array(0 => array('file', '/dev/null', 'r'), 1 => array('pipe', 'w'), 2 => array('file', '/dev/null', 'w')),
                $pipes
            );
            if (is_resource($p)) {
                $ver = trim((string) stream_get_contents($pipes[1]));
                fclose($pipes[1]);
                proc_close($p);
            }
        }
        if (preg_match('/^[0-9]+\.[0-9]+$/', $ver) === 1) {
            return 'apt-get install -y php' . $ver . '-sqlite3';
        }

        return 'apt-get install -y php-sqlite3 php8.5-sqlite3 php8.6-sqlite3';
    }

    public static function ubuntuSupported(string $id, string $version): bool
    {
        if ($id !== 'ubuntu') {
            return false;
        }
        return str_starts_with($version, '24.04') || str_starts_with($version, '26.');
    }

    /** @return array{id:string,version:string,pretty:string} */
    private function osId(): array
    {
        $file = '/etc/os-release';
        $id = '';
        $ver = '';
        $pretty = '';
        if (is_readable($file)) {
            foreach (file($file, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
                if (str_starts_with($line, 'ID=')) {
                    $id = trim(trim(substr($line, 3)), '"');
                }
                if (str_starts_with($line, 'VERSION_ID=')) {
                    $ver = trim(trim(substr($line, 11)), '"');
                }
                if (str_starts_with($line, 'PRETTY_NAME=')) {
                    $pretty = trim(trim(substr($line, 12)), '"');
                }
            }
        }
        return ['id' => $id, 'version' => $ver, 'pretty' => $pretty];
    }

    private function snapshot(): int
    {
        $manifest = $this->createSnapshot();
        $msg = 'snapshot ' . $manifest['stamp'] . ' (' . count($manifest['paths']) . ' paths) -> ' . $manifest['dir'];
        return $this->say($manifest, $msg);
    }

    /** @return array{stamp:string,created_utc:string,kloxocp:string,root:string,paths:list<string>,dir:string} */
    private function createSnapshot(): array
    {
        if (!is_dir($this->root . '/httpdocs')) {
            throw new KcpException("Not a program root (no httpdocs): {$this->root}");
        }
        $keep = 5;
        if (isset($this->opt['keep']) && is_string($this->opt['keep']) && ctype_digit($this->opt['keep'])) {
            $keep = (int) $this->opt['keep'];
            if ($keep < 1 || $keep > 50) {
                throw new KcpException('--keep must be 1–50');
            }
        }
        $dest = '';
        $stamp = '';
        for ($i = 0; $i < 20; $i++) {
            $stamp = gmdate('YmdHis') . sprintf('%03d', (int) ((microtime(true) * 1000) % 1000));
            $dest = Fs::realDir($this->snapDir, 'snap-dir') . '/' . $stamp;
            if (!is_dir($dest)) {
                break;
            }
            usleep(5000);
        }
        if ($dest === '' || is_dir($dest)) {
            throw new KcpException("Snapshot already exists: $dest");
        }
        if (!mkdir($dest, 0750, true) && !is_dir($dest)) {
            throw new KcpException("Cannot create $dest");
        }
        $copied = [];
        foreach (KCP_SNAP_PATHS as $rel) {
            $src = $this->root . '/' . $rel;
            if (!file_exists($src)) {
                continue;
            }
            Fs::copyPath($src, $dest . '/' . $rel);
            $copied[] = $rel;
        }
        foreach (KCP_SNAP_SIDECARS as $host => $rel) {
            if (!is_file($host)) {
                $alt = $this->root . '/var/lib/kloxo/panel.sqlite';
                if ($rel === 'var/panel.sqlite' && is_file($alt)) {
                    $host = $alt;
                } else {
                    continue;
                }
            }
            $target = $dest . '/' . $rel;
            $dir = dirname($target);
            if (!is_dir($dir) && !mkdir($dir, 0750, true) && !is_dir($dir)) {
                throw new KcpException("Cannot create $dir");
            }
            Fs::copyPath($host, $target);
            $copied[] = $rel;
        }
        $manifest = [
            'stamp' => $stamp,
            'created_utc' => gmdate('c'),
            'kloxocp' => KCP_VERSION,
            'root' => $this->root,
            'paths' => $copied,
            'dir' => $dest,
        ];
        file_put_contents($dest . '/MANIFEST.json', json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
        $this->pruneSnapshots($keep);
        return $manifest;
    }

    private function rollback(): int
    {
        $stamp = $this->opt['stamp'] ?? '';
        if (!is_string($stamp) || $stamp === '' || $stamp === true) {
            $stamp = $this->latestStamp($this->snapDir) ?? '';
        }
        $restored = $this->quietRestoreSnapshot($stamp);
        $rep = ['stamp' => $stamp, 'restored' => $restored, 'root' => $this->root];
        return $this->say($rep, 'restored snapshot ' . $stamp . ' (' . count($restored) . ' paths)');
    }

    /** @return list<string> */
    private function quietRestoreSnapshot(string $stamp): array
    {
        $snapRoot = $this->snapDir;
        if (!is_dir($snapRoot)) {
            throw new KcpException("No snapshots in $snapRoot");
        }
        if ($stamp === '' || !preg_match('/^[0-9]{14,17}$/', $stamp)) {
            throw new KcpException('No snapshot stamp (run kloxocp snapshot first)');
        }
        $src = $snapRoot . '/' . $stamp;
        if (!is_file($src . '/MANIFEST.json')) {
            throw new KcpException("Invalid snapshot: $src");
        }
        if (!is_dir($this->root . '/httpdocs')) {
            throw new KcpException("Not a program root: {$this->root}");
        }
        $restored = [];
        foreach (KCP_SNAP_PATHS as $rel) {
            $from = $src . '/' . $rel;
            if (!file_exists($from)) {
                continue;
            }
            $to = $this->root . '/' . $rel;
            $bak = $to . '.kloxocp-pre-rollback';
            Fs::rmTree($bak);
            if (is_dir($to) || is_file($to) || is_link($to)) {
                rename($to, $bak);
            }
            Fs::copyPath($from, $to);
            Fs::rmTree($bak);
            $restored[] = $rel;
        }
        $side = $src . '/var/panel.sqlite';
        if (is_file($side)) {
            $targets = [];
            if (is_dir('/var/lib/kloxo')) {
                $targets[] = '/var/lib/kloxo/panel.sqlite';
            }
            $alt = $this->root . '/var/lib/kloxo';
            if (is_dir($alt)) {
                $targets[] = $alt . '/panel.sqlite';
            }
            foreach (array_unique($targets) as $db) {
                $bak = $db . '.kloxocp-pre-rollback';
                if (is_file($db)) {
                    @rename($db, $bak);
                }
                Fs::copyPath($side, $db);
                @chmod($db, 0640);
                if (is_file($bak) || is_dir($bak) || is_link($bak)) {
                    Fs::rmTree($bak);
                }
                $restored[] = $db;
            }
        }
        return $restored;
    }

    private function latestStamp(string $snapRoot): ?string
    {
        $best = null;
        foreach (scandir($snapRoot) ?: [] as $n) {
            if (preg_match('/^[0-9]{14,17}$/', $n) && is_file("$snapRoot/$n/MANIFEST.json")) {
                if ($best === null || $n > $best) {
                    $best = $n;
                }
            }
        }
        return $best;
    }

    private function pruneSnapshots(int $keep): void
    {
        if (!is_dir($this->snapDir)) {
            return;
        }
        $stamps = [];
        foreach (scandir($this->snapDir) ?: [] as $n) {
            if (preg_match('/^[0-9]{14,17}$/', $n) && is_dir($this->snapDir . '/' . $n)) {
                $stamps[] = $n;
            }
        }
        rsort($stamps, SORT_STRING);
        foreach (array_slice($stamps, $keep) as $old) {
            Fs::rmTree($this->snapDir . '/' . $old);
        }
    }

    /** @param list<string> $rest */
    private function component(array $rest): int
    {
        $sub = $rest[0] ?? 'list';
        if ($sub === 'list') {
            $lines = [];
            foreach (KCP_COMPONENTS as $name => $desc) {
                $lines[] = sprintf("%-12s %s", $name, $desc);
            }
            return $this->say(['components' => array_keys(KCP_COMPONENTS)], implode("\n", $lines));
        }
        return $this->notImplemented('component ' . $sub);
    }

    private function update(): int
    {
        $checkOnly = isset($this->opt['check']);
        $noFetch = isset($this->opt['no-fetch']);
        $noRollback = isset($this->opt['no-rollback']);
        if (!is_dir($this->root . '/httpdocs')) {
            throw new KcpException("Not a program root (no httpdocs): {$this->root}");
        }

        $src = $this->resolveUpdateSrc();
        $branch = 'main';
        if (isset($this->opt['branch']) && is_string($this->opt['branch']) && $this->opt['branch'] !== '' && $this->opt['branch'] !== true) {
            if (!preg_match('/^[A-Za-z0-9._\/-]{1,64}$/', $this->opt['branch'])) {
                throw new KcpException('Invalid --branch');
            }
            $branch = $this->opt['branch'];
        }

        $fromVersion = $this->readVersion($this->root);
        $toVersion = $this->readVersion($src . '/kloxo');
        $plan = [
            'action' => 'update',
            'root' => $this->root,
            'src' => $src,
            'branch' => $branch,
            'from_version' => $fromVersion,
            'to_version' => $toVersion,
            'fetch' => !$noFetch && is_dir($src . '/.git'),
            'auto_rollback' => !$noRollback,
            'check_only' => $checkOnly,
        ];

        if ($checkOnly) {
            $msg = "update check: {$fromVersion} -> {$toVersion} from {$src}"
                . ($plan['fetch'] ? " (git fetch {$branch})" : ' (no fetch)');
            return $this->say($plan, $msg);
        }

        $this->requireRootOrWritable('upcp');
        $lock = $this->acquireUpdateLock();
        $logFile = $this->updateLogPath();
        $this->ulog($logFile, "update start {$fromVersion} -> {$toVersion} src={$src}");

        $stamp = null;
        $rolled = false;
        try {
            $this->ulog($logFile, 'pre-flight');
            $this->updatePreflight($src);

            $this->ulog($logFile, 'snapshot');
            $stamp = $this->takeSnapshotStamp();
            $plan['snapshot'] = $stamp;

            if ($plan['fetch']) {
                $this->ulog($logFile, "git fetch {$branch}");
                $this->gitFetch($src, $branch);
                $toVersion = $this->readVersion($src . '/kloxo');
                $plan['to_version'] = $toVersion;
            }

            $this->ulog($logFile, 'apply');
            $synced = $this->applyUpdateTree($src . '/kloxo');
            $plan['synced'] = $synced;

            $this->ulog($logFile, 'health check');
            $health = $this->updateHealthCheck();
            $plan['health'] = $health;
            if (!$health['ok']) {
                throw new KcpException('health check failed: ' . implode('; ', $health['errors']));
            }

            // force-fail hook for tests / drills
            if (getenv('KLOXO_UPDATE_FORCE_FAIL') === '1') {
                throw new KcpException('forced failure (KLOXO_UPDATE_FORCE_FAIL=1)');
            }

            $this->ulog($logFile, 'host links');
            $plan['host_links'] = $this->refreshHostLinks();

            // Reload panel PHP + backend so the in-memory version stamp matches
            // bin/kloxoversion (otherwise Fail2Ban/UFW hit slave_upgrading).
            $this->ulog($logFile, 'restart panel services');
            $plan['restarted'] = $this->restartPanelServices();

            $this->ulog($logFile, "update ok {$toVersion} snapshot={$stamp}");
            $plan['ok'] = true;
            $plan['rolled_back'] = false;
            return $this->say($plan, "update ok: {$fromVersion} -> {$toVersion} (snapshot {$stamp})");
        } catch (Throwable $e) {
            $this->ulog($logFile, 'update FAILED: ' . $e->getMessage());
            if (!$noRollback && is_string($stamp) && $stamp !== '') {
                $this->ulog($logFile, "auto-rollback to {$stamp}");
                try {
                    $this->quietRestoreSnapshot($stamp);
                    $rolled = true;
                    $this->ulog($logFile, "rollback ok {$stamp}");
                } catch (Throwable $re) {
                    $this->ulog($logFile, 'rollback FAILED: ' . $re->getMessage());
                    throw new KcpException(
                        'update failed (' . $e->getMessage() . '); rollback also failed: ' . $re->getMessage()
                    );
                }
            }
            $plan['ok'] = false;
            $plan['rolled_back'] = $rolled;
            $plan['error'] = $e->getMessage();
            if ($this->json) {
                echo json_encode($plan, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . "\n";
            } else {
                $tail = $rolled ? " (rolled back to snapshot {$stamp})" : ' (no rollback)';
                fwrite(STDERR, 'error: update failed: ' . $e->getMessage() . $tail . "\n");
            }
            return 1;
        } finally {
            $this->releaseUpdateLock($lock);
        }
    }

    private function resolveUpdateSrc(): string
    {
        $opt = $this->opt['src'] ?? '';
        if (is_string($opt) && $opt !== '' && $opt !== true) {
            if (str_contains($opt, "\0") || str_contains($opt, '..')) {
                throw new KcpException('Invalid --src');
            }
            $src = rtrim($opt, '/');
            if (!is_file($src . '/kloxo/bin/kloxocp')) {
                throw new KcpException("Not a Kloxo CP source tree: $src");
            }
            return $src;
        }
        $defaults = [
            '/usr/local/src/kloxo-cp',
            dirname($this->root),
            dirname(__DIR__, 2),
        ];
        // If /opt/kloxo is a symlink into the clone, use that clone.
        $link = @readlink($this->root);
        if (is_string($link) && $link !== '') {
            $parent = dirname($link);
            if (is_file($parent . '/kloxo/bin/kloxocp')) {
                array_unshift($defaults, $parent);
            } elseif (is_file($parent . '/bin/kloxocp') && is_file(dirname($parent) . '/kloxo/bin/kloxocp')) {
                array_unshift($defaults, dirname($parent));
            }
        }
        foreach ($defaults as $d) {
            if (is_string($d) && $d !== '' && is_file($d . '/kloxo/bin/kloxocp')) {
                return $d;
            }
        }
        throw new KcpException('No update source (--src=DIR or /usr/local/src/kloxo-cp)');
    }

    private function readVersion(string $programRoot): string
    {
        $f = $programRoot . '/bin/kloxoversion';
        if (is_file($f)) {
            $v = trim((string) file_get_contents($f));
            if ($v !== '') {
                return $v;
            }
        }
        return KCP_VERSION;
    }

    private function updateLogPath(): string
    {
        if (is_dir('/var/log') && is_writable('/var/log')) {
            return '/var/log/kloxo-update.log';
        }
        $dir = $this->root . '/log';
        if (!is_dir($dir)) {
            @mkdir($dir, 0750, true);
        }
        return $dir . '/kloxo-update.log';
    }

    private function ulog(string $file, string $msg): void
    {
        $line = gmdate('c') . ' ' . $msg . "\n";
        @file_put_contents($file, $line, FILE_APPEND | LOCK_EX);
        if (!$this->json) {
            echo '==> ' . $msg . "\n";
        }
    }

    /**
     * Live /opt/kloxo is root-owned; a normal login cannot create the update
     * lock and used to fail with "Cannot open update lock". Temp trees used
     * by tests stay writable without root.
     */
    private function requireRootOrWritable(string $cmd): void
    {
        $uid = function_exists('posix_geteuid') ? (int) posix_geteuid() : -1;
        if ($uid === 0) {
            return;
        }
        $var = $this->root . '/var';
        if (is_dir($var) && is_writable($var)) {
            return;
        }
        if (!is_dir($var) && is_writable($this->root)) {
            return;
        }
        throw new KcpException("Must run as root: sudo kloxocp {$cmd}");
    }

    /** @return resource|null */
    private function acquireUpdateLock()
    {
        $dir = $this->root . '/var';
        if (!is_dir($dir) && !mkdir($dir, 0750, true) && !is_dir($dir)) {
            throw new KcpException("Cannot create $dir (run as root: sudo kloxocp upcp)");
        }
        $path = $dir . '/kloxocp-update.lock';
        $fh = @fopen($path, 'c+');
        if ($fh === false) {
            throw new KcpException("Cannot open update lock $path (run as root: sudo kloxocp upcp)");
        }
        if (!flock($fh, LOCK_EX | LOCK_NB)) {
            fclose($fh);
            throw new KcpException('Another kloxocp update is already running');
        }
        ftruncate($fh, 0);
        fwrite($fh, (string) getmypid() . "\n" . gmdate('c') . "\n");
        fflush($fh);
        return $fh;
    }

    /** @param resource|null $fh */
    private function releaseUpdateLock($fh): void
    {
        if (is_resource($fh)) {
            flock($fh, LOCK_UN);
            fclose($fh);
        }
    }

    private function updatePreflight(string $src): void
    {
        if (!is_file($src . '/kloxo/bin/kloxocp')) {
            throw new KcpException("Source missing kloxo/bin/kloxocp: $src");
        }
        if (!is_file($src . '/kloxo/httpdocs/login/index.php') && !is_file($src . '/kloxo/httpdocs/login/login.php')) {
            // login may be index.php in this tree
            if (!is_dir($src . '/kloxo/httpdocs/login')) {
                throw new KcpException('Source missing httpdocs/login');
            }
        }
        $free = @disk_free_space($this->root);
        if (is_float($free) || is_int($free)) {
            if ((int) $free < 200 * 1024 * 1024) {
                throw new KcpException('Need at least ~200 MB free disk for update/snapshot');
            }
        }
        foreach (['/usr/local/cpanel', '/usr/local/psa', '/usr/local/ispconfig'] as $other) {
            if (is_dir($other)) {
                throw new KcpException("Another control panel is present at $other");
            }
        }
    }

    private function takeSnapshotStamp(): string
    {
        $manifest = $this->createSnapshot();
        return $manifest['stamp'];
    }

    private function gitFetch(string $src, string $branch): void
    {
        if (!Proc::exists('git')) {
            throw new KcpException('git is required to fetch updates (or pass --no-fetch)');
        }
        [$rc, $o, $e] = Proc::run(['git', '-C', $src, 'fetch', '--depth', '1', 'origin', $branch]);
        if ($rc !== 0) {
            throw new KcpException('git fetch failed: ' . trim($e !== '' ? $e : $o));
        }
        [$rc, $o, $e] = Proc::run(['git', '-C', $src, 'checkout', '-f', '-B', $branch, 'FETCH_HEAD']);
        if ($rc !== 0) {
            throw new KcpException('git checkout failed: ' . trim($e !== '' ? $e : $o));
        }
        [$rc, $o, $e] = Proc::run(['git', '-C', $src, 'reset', '--hard', 'FETCH_HEAD']);
        if ($rc !== 0) {
            throw new KcpException('git reset failed: ' . trim($e !== '' ? $e : $o));
        }
    }

    /**
     * install.sh default: /opt/kloxo → /usr/local/src/kloxo-cp/kloxo.
     * git fetch already updates the live tree; copying would rename our own
     * bin/ and PHP copy() fails on same-inode destinations.
     */
    private function sameProgramTree(string $srcKloxo): bool
    {
        $a = realpath($srcKloxo);
        $b = realpath($this->root);

        return $a !== false && $b !== false && $a === $b;
    }

    /** @return list<string> */
    private function applyUpdateTree(string $srcKloxo): array
    {
        if (!is_dir($srcKloxo . '/httpdocs') || !is_dir($srcKloxo . '/bin')) {
            throw new KcpException("Invalid program tree: $srcKloxo");
        }
        if ($this->sameProgramTree($srcKloxo)) {
            return ['(live symlink; git fetch already applied)'];
        }
        $synced = [];
        foreach (KCP_UPDATE_SYNC as $rel) {
            if ($rel === 'bin/kloxoversion') {
                continue; // handled below
            }
            $from = $srcKloxo . '/' . $rel;
            if (!file_exists($from)) {
                continue;
            }
            $to = $this->root . '/' . $rel;
            // replace directory contents safely: copy to temp then swap
            if (is_dir($from)) {
                $tmp = $to . '.kloxocp-new';
                Fs::rmTree($tmp);
                Fs::copyPath($from, $tmp);
                $bak = $to . '.kloxocp-old';
                Fs::rmTree($bak);
                if (is_dir($to) || is_file($to) || is_link($to)) {
                    rename($to, $bak);
                }
                rename($tmp, $to);
                Fs::rmTree($bak);
            } else {
                Fs::copyPath($from, $to);
            }
            $synced[] = $rel;
        }
        // always refresh version stamp when present
        if (is_file($srcKloxo . '/bin/kloxoversion')) {
            Fs::copyPath($srcKloxo . '/bin/kloxoversion', $this->root . '/bin/kloxoversion');
            if (!in_array('bin/kloxoversion', $synced, true)) {
                $synced[] = 'bin/kloxoversion';
            }
        }
        return $synced;
    }

    /**
     * Restart panel FPM and kloxo-backend after upcp so they reload the new
     * tree and version stamp. Best-effort; missing systemctl is fine in tests.
     *
     * @return list<string>
     */
    private function restartPanelServices(): array
    {
        $done = [];
        $uid = function_exists('posix_geteuid') ? (int) posix_geteuid() : -1;
        if ($uid !== 0 || !Proc::exists('systemctl')) {
            return ['(skipped)'];
        }
        foreach (['kloxo-backend', 'kloxo-php'] as $unit) {
            [$rc] = Proc::run(['systemctl', 'try-restart', $unit]);
            $done[] = $unit . ($rc === 0 ? ': restarted' : ': try-restart rc=' . $rc);
        }

        return $done;
    }

    /**
     * Keep /script, lxphp.exe and /usr/local/sbin/kloxocp pointing at this tree
     * after an update (and after a symlink-only git fetch apply).
     *
     * @return list<string>
     */
    private function refreshHostLinks(): array
    {
        $done = [];
        $uid = function_exists('posix_geteuid') ? (int) posix_geteuid() : -1;
        if ($uid !== 0) {
            return ['(skipped; not root)'];
        }
        $pscript = $this->root . '/pscript';
        if (is_dir($pscript)) {
            @unlink('/script');
            if (@symlink($pscript, '/script')) {
                $done[] = '/script';
            }
        }
        $cli = $this->root . '/init/php-cli.sh';
        if (is_file($cli)) {
            @chmod($cli, 0755);
            foreach (['/usr/bin/lxphp.exe', '/usr/bin/lphp.exe'] as $link) {
                @unlink($link);
                if (@symlink($cli, $link)) {
                    $done[] = $link;
                }
            }
        }
        $kloxocp = $this->root . '/bin/kloxocp';
        if (is_file($kloxocp)) {
            @chmod($kloxocp, 0755);
            @unlink('/usr/local/sbin/kloxocp');
            if (@symlink($kloxocp, '/usr/local/sbin/kloxocp')) {
                $done[] = '/usr/local/sbin/kloxocp';
            }
        }
        $kloxomail = $this->root . '/bin/mail/kloxo-mail';
        if (is_file($kloxomail)) {
            @chmod($kloxomail, 0755);
            @unlink('/usr/local/sbin/kloxo-mail');
            if (@symlink($kloxomail, '/usr/local/sbin/kloxo-mail')) {
                $done[] = '/usr/local/sbin/kloxo-mail';
            }
        }
        // Ensure /script/upcp and /script/directory are executable wrappers.
        foreach (['upcp', 'update', 'directory'] as $name) {
            $p = $pscript . '/' . $name;
            if (is_file($p)) {
                @chmod($p, 0755);
            }
        }

        return $done !== [] ? $done : ['(no links changed)'];
    }

    /** @return array{ok:bool,errors:list<string>} */
    private function updateHealthCheck(): array
    {
        $errors = [];
        if (!is_dir($this->root . '/httpdocs')) {
            $errors[] = 'httpdocs missing';
        }
        if (!is_file($this->root . '/bin/kloxocp')) {
            $errors[] = 'bin/kloxocp missing';
        }
        if (!is_dir($this->root . '/httpdocs/login')) {
            $errors[] = 'httpdocs/login missing';
        }
        $login = $this->root . '/httpdocs/login';
        $hasLogin = is_file($login . '/index.php') || is_file($login . '/login.php')
            || is_file($login . '/index.html');
        if (!$hasLogin) {
            // directory may only have assets in some trees; require non-empty
            $files = @scandir($login) ?: [];
            $files = array_values(array_filter($files, static fn ($n) => $n !== '.' && $n !== '..'));
            if ($files === []) {
                $errors[] = 'httpdocs/login is empty';
            }
        }
        // PHP lint the CLI itself (prefer panel php-cli / pin over PHP Used).
        $php = $this->panelPhpBinary();
        if ($php !== '') {
            [$rc, , $e] = Proc::run([$php, '-l', $this->root . '/bin/kloxocp']);
            if ($rc !== 0) {
                $errors[] = 'php -l kloxocp failed: ' . trim($e);
            }
        }
        $dirHelper = $this->root . '/pscript/directory';
        if (is_file($dirHelper)) {
            $dirSrc = (string) file_get_contents($dirHelper);
            if (!str_contains($dirSrc, 'httpdocs') || str_contains($dirSrc, '/opt/kloxo/$(cat')) {
                $errors[] = 'pscript/directory still uses the legacy Kloxo-MR path';
            }
        }
        // optional unit probes (do not fail update if systemctl absent)
        if (Proc::exists('systemctl')) {
            foreach (['kloxo-web', 'kloxo-php', 'kloxo-backend'] as $unit) {
                [$rc] = Proc::run(['systemctl', 'is-active', '--quiet', $unit]);
                // only warn via errors if unit exists and is failed
                [$rcShow, $o] = Proc::run(['systemctl', 'show', '-p', 'ActiveState', '--value', $unit]);
                $state = trim($o);
                if ($rcShow === 0 && $state === 'failed') {
                    $errors[] = "$unit is failed";
                }
            }
        }
        return ['ok' => $errors === [], 'errors' => $errors];
    }

    /** PHP binary for panel tools (php-cli.sh, pin, then PATH php). */
    private function panelPhpBinary(): string
    {
        $env = getenv('KLOXO_PHP');
        if (is_string($env) && $env !== '' && is_executable($env)) {
            return $env;
        }
        $cli = $this->root . '/init/php-cli.sh';
        if (is_executable($cli) || is_file($cli)) {
            return $cli;
        }
        $pinFile = $this->root . '/etc/path/php';
        if (is_file($pinFile)) {
            $pin = trim((string) file_get_contents($pinFile));
            if ($pin !== '' && is_executable($pin)) {
                return $pin;
            }
        }
        foreach (['/usr/bin/php8.5', '/usr/bin/php8.4', '/usr/bin/php8.3', '/usr/bin/php'] as $p) {
            if (is_executable($p)) {
                return $p;
            }
        }

        return Proc::exists('php') ? 'php' : '';
    }

    private function install(): int
    {
        $this->opt['install'] = true;
        $rc = $this->doctor();
        if ($rc !== 0) {
            fwrite(STDERR, "error: pre-flight failed; not installing\n");
            return 1;
        }
        $msg = "pre-flight ok. Run install.sh on Ubuntu 24.04 or 26.x as root (see README.md).\n"
            . "Debian packages / signed apt repo are not built.";
        $this->say(['implemented' => false, 'preflight' => true], $msg);
        return 2;
    }

    /** @param array<string,mixed> $data */
    private function say(array $data, string $text): int
    {
        if ($this->json) {
            echo json_encode($data, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . "\n";
        } else {
            echo $text . "\n";
        }
        return 0;
    }
}

exit((new App())->run($argv));
