#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * kloxocp: operator CLI for Kloxo CP (status, doctor, snapshot, rollback).
 *
 * Copyright (C) 2026 Kloxo CP contributors
 *
 * This program is free software: you can redistribute it and/or modify it
 * under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at
 * your option) any later version. See LICENSE.txt.
 *
 * Standalone: no legacy panel includes. PHP 8.3, argument-array process
 * execution, validated paths. update/upcp: snapshot, apply, health check,
 * automatic rollback on failure (cPanel-style). Signed apt packages are not
 * built; the update syncs from the git clone (or --src=DIR).
 *
 * Usage: kloxocp <command> [arguments] [--options]
 */

// Prefer the pinned panel PHP (etc/path/php) when this process has no
// pdo_sqlite — Ubuntu 26 may leave /usr/bin/php on 8.6 RC without sqlite3
// while the pin stays on php8.5 with the extension.
(static function (): void {
	if (extension_loaded('pdo_sqlite')) {
		return;
	}
	$root = getenv('KLOXO_ROOT');
	if (!is_string($root) || $root === '') {
		$root = '/opt/kloxo';
	}
	$candidates = array();
	$pinFile = $root . '/etc/path/php';
	if (is_file($pinFile)) {
		$pin = trim((string) file_get_contents($pinFile));
		if ($pin !== '' && is_executable($pin)) {
			$candidates[] = $pin;
		}
	}
	foreach (array('/usr/bin/php8.5', '/usr/bin/php8.4', '/usr/bin/php8.3', '/usr/bin/php8.6', '/usr/bin/php') as $p) {
		$candidates[] = $p;
	}
	$self = realpath((string) (PHP_BINARY ?: '')) ?: '';
	$script = realpath((string) ($_SERVER['SCRIPT_FILENAME'] ?? __FILE__)) ?: __FILE__;
	foreach ($candidates as $bin) {
		if (!is_executable($bin)) {
			continue;
		}
		$real = realpath($bin) ?: $bin;
		if ($self !== '' && $real === $self) {
			continue;
		}
		$p = @proc_open(
			array($bin, '-r', 'exit(extension_loaded("pdo_sqlite") ? 0 : 1);'),
			array(0 => array('file', '/dev/null', 'r'), 1 => array('file', '/dev/null', 'w'), 2 => array('file', '/dev/null', 'w')),
			$pipes
		);
		if (!is_resource($p) || proc_close($p) !== 0) {
			continue;
		}
		$argv = array_merge(array($bin, $script), array_slice($_SERVER['argv'] ?? array(), 1));
		if (function_exists('pcntl_exec')) {
			pcntl_exec($bin, array_slice($argv, 1));
		}
		$cmd = '';
		foreach ($argv as $a) {
			$cmd .= ($cmd === '' ? '' : ' ') . escapeshellarg((string) $a);
		}
		passthru($cmd, $rc);
		exit(is_int($rc) ? $rc : 1);
	}
})();

