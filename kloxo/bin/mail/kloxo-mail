    // --- mailboxes -----------------------------------------------------------------------
    private function mailboxAdd(): int
    {
        [$email, , $dom] = V::email($this->arg(0, 'email'));
        $d = $this->db()->domain($dom);
        if (!$d['active']) {
            throw new KmException("Domain $dom is disabled");
        }
        if ((int)$d['max_mailboxes'] > 0) {
            $n = (int)$this->db()->one('SELECT COUNT(*) AS n FROM mailboxes WHERE domain_id = ?', [$d['id']])['n'];
            if ($n >= (int)$d['max_mailboxes']) {
                throw new KmException("Mailbox limit reached for $dom");
            }
        }
        if ($this->db()->one('SELECT 1 FROM aliases WHERE source = ?', [$email])) {
            throw new KmException("$email already exists as an alias");
        }
        $pw = $this->readPassword();
        $quota = isset($this->opt['quota']) ? (int)$this->opt['quota'] : (int)$d['default_quota_mb'];
        [$e, $l] = [$email, explode('@', $email)[0]];
        $this->db()->exec('INSERT INTO mailboxes (domain_id, local_part, email, password_hash, quota_mb) VALUES (?, ?, ?, ?, ?)', [$d['id'], $l, $e, $this->hash($pw), $quota]);
        return $this->say(['mailbox' => $e, 'quota_mb' => $quota], "Mailbox $e created (quota {$quota} MB)");
    }

