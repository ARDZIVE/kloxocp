    // --- aliases, forwarders, catch-all --------------------------------------------------------
    private function aliasAdd(): int
    {
        [$src, $dom] = V::aliasSource($this->arg(0, 'source'));
        $targets = array_slice($this->args, 1);
        if (!$targets) {
            throw new KmException('Give at least one target address');
        }
        $d = $this->db()->domain($dom);
        if (!str_starts_with($src, '@') && $this->db()->one('SELECT 1 FROM mailboxes WHERE email = ?', [$src]) && !in_array($src, array_map(fn($t) => V::email($t)[0], $targets), true)) {
            // Forwarding a real mailbox without keeping a copy is allowed, but say so.
            fwrite(STDERR, "note: $src is a mailbox; mail will be forwarded without a local copy unless you add $src as a target\n");
        }
        $pdo = $this->db()->pdo();
        $pdo->beginTransaction();
        try {
            $a = $this->db()->one('SELECT id FROM aliases WHERE source = ?', [$src]);
            $id = $a ? (int)$a['id'] : null;
            if ($id === null) {
                $this->db()->exec('INSERT INTO aliases (domain_id, source) VALUES (?, ?)', [$d['id'], $src]);
                $id = (int)$pdo->lastInsertId();
            }
            foreach ($targets as $t) {
                [$te] = V::email($t);
                $this->db()->exec('INSERT IGNORE INTO alias_targets (alias_id, target) VALUES (?, ?)', [$id, $te]);
            }
            $pdo->commit();
        } catch (Throwable $e) {
            $pdo->rollBack();
            throw $e;
        }
        return $this->say(['alias' => $src, 'targets' => array_map(fn($t) => V::email($t)[0], $targets)], "Alias $src updated");
    }

    private function aliasDel(): int
    {
        [$src] = V::aliasSource($this->arg(0, 'source'));
        $a = $this->db()->one('SELECT id FROM aliases WHERE source = ?', [$src]);
        if (!$a) {
            throw new KmException("Alias not found: $src");
        }
        if (isset($this->args[1])) {
            [$t] = V::email($this->args[1]);
            $this->db()->exec('DELETE FROM alias_targets WHERE alias_id = ? AND target = ?', [$a['id'], $t]);
            if (!$this->db()->one('SELECT 1 FROM alias_targets WHERE alias_id = ?', [$a['id']])) {
                $this->db()->exec('DELETE FROM aliases WHERE id = ?', [$a['id']]);
            }
        } else {
            $this->db()->exec('DELETE FROM aliases WHERE id = ?', [$a['id']]);
        }
        return $this->say(['alias' => $src], "Alias $src updated/removed");
    }

