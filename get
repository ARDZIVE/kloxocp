#!/bin/bash
# Kloxo CP — one-line installer bootstrap.
#
# Fresh Ubuntu 24.04 or 26.x as root (full stack = Exim + Dovecot + Rspamd, no questions):
#
#   curl -fsSL https://raw.githubusercontent.com/ARDZIVE/kloxocp/main/get | sudo bash
#
# With flags (note bash -s --):
#
#   curl -fsSL https://raw.githubusercontent.com/ARDZIVE/kloxocp/main/get | sudo bash -s -- --yes
#   curl -fsSL https://raw.githubusercontent.com/ARDZIVE/kloxocp/main/get | sudo bash -s -- --profile=full
#   curl -fsSL https://raw.githubusercontent.com/ARDZIVE/kloxocp/main/get | sudo bash -s -- --profile=core
#   curl -fsSL https://raw.githubusercontent.com/ARDZIVE/kloxocp/main/get | sudo bash -s -- --fresh --yes
#
# Panel: https://<ip>:7777/  admin / admin
# First login: Change Password, then Mail Setup (admin email + mail FQDN).
# After PHP Used, panel CLI tools: /opt/kloxo/init/php-cli.sh … (not bare php).
# Spam filter is Rspamd (Switch Program); SpamAssassin is not installed.
# Packages certbot (Let's Encrypt), Fail2Ban, UFW; LogWatch packaged but
# disabled until Security > LogWatch. Visitor Stats timer is enabled.
#
# This file only fetches install.sh and runs it. apt never reads the pipe
# (install.sh redirects stdin from /dev/null before any package work).
set -euo pipefail

KLOXO_GET_URL="${KLOXO_GET_URL:-https://raw.githubusercontent.com/ARDZIVE/kloxocp/main/install.sh}"
KLOXO_GET_TMP="${KLOXO_GET_TMP:-/tmp/kloxocp-install.sh}"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[[ "$(id -u)" -eq 0 ]] || die "run as root (curl ... | sudo bash)"

# Prefer a sibling install.sh when this tree was copied onto the server.
HERE=""
if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
  HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
if [[ -n "$HERE" && -f "$HERE/install.sh" && -f "$HERE/kloxo/bin/kloxocp" ]]; then
  exec bash "$HERE/install.sh" "$@"
fi

need_fetcher() {
  command -v curl >/dev/null 2>&1 && return 0
  command -v wget >/dev/null 2>&1 && return 0
  return 1
}

if ! need_fetcher; then
  command -v apt-get >/dev/null 2>&1 || die "need curl or wget (or apt-get to install curl)"
  export DEBIAN_FRONTEND=noninteractive
  # stdin may be this script when piped; never let apt consume it.
  # Drop half-written pkgcache/srcpkgcache (needrestart / concurrent apt).
  mkdir -p /var/cache/apt /var/lib/apt/lists/partial
  rm -f /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin \
    /var/cache/apt/pkgcache.bin.* /var/cache/apt/srcpkgcache.bin.* \
    /var/cache/apt/*.bin 2>/dev/null || true
  apt-get -o DPkg::Lock::Timeout=600 clean </dev/null >/dev/null 2>&1 || true
  if ! apt-get -o DPkg::Lock::Timeout=600 update </dev/null; then
    rm -f /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin \
      /var/cache/apt/*.bin 2>/dev/null || true
    find /var/lib/apt/lists -mindepth 1 -maxdepth 1 ! -name 'partial' -exec rm -rf {} + 2>/dev/null || true
    apt-get -o DPkg::Lock::Timeout=600 update </dev/null || die "apt-get update failed"
  fi
  apt-get -o DPkg::Lock::Timeout=600 install -y ca-certificates curl </dev/null
fi

url="${KLOXO_GET_URL}?nocache=$(date +%s)"
printf 'Kloxo CP: downloading installer...\n'
if command -v curl >/dev/null 2>&1; then
  curl -fsSL "$url" -o "$KLOXO_GET_TMP" || die "download failed: $KLOXO_GET_URL"
else
  wget -qO "$KLOXO_GET_TMP" "$url" || die "download failed: $KLOXO_GET_URL"
fi
chmod 0700 "$KLOXO_GET_TMP"
exec bash "$KLOXO_GET_TMP" "$@"
